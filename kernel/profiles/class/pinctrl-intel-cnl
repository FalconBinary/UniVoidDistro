# kernel/profiles/class/pinctrl-intel-cnl: the Cannon Lake / Comet Lake-H pin controller (cpu.intel.pinctrl.cnl).
#
# A class fragment: vh-kconf resolve applies it when the machine's plan names it
# (vh-plan, hwdb/); a symbol of it that does not survive olddefconfig is an error, as for
# mandatory.

# The i2c-hid touchpad's GPIO interrupt hangs off it; no modalias of the touchpad names it.
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_CANNONLAKE=y
