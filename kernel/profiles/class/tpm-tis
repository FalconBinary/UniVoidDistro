# kernel/profiles/class/tpm-tis: a discrete TPM on the TIS interface (tpm.tis).
#
# A class fragment: vh-kconf resolve applies it when the machine's plan names it
# (vh-plan, hwdb/); a symbol of it that does not survive olddefconfig is an error, as for
# mandatory.

CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
# HW_RANDOM_TPM sits on the hw_random core, which a module list need not name (kernel-custom
# run 39318902051: intel-hybrid-laptop and qemu-q35 lost it).
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_TPM=y
