# kernel/profiles/class/gpu-i915: Intel graphics up to Gen12 (gpu.i915).
#
# A class fragment: vh-kconf resolve applies it when the machine's plan names it
# (vh-plan, hwdb/); a symbol of it that does not survive olddefconfig is an error, as for
# mandatory.

# The console moves from the EFI framebuffer to i915 early; built in, so the firmware (DMC,
# GuC, HuC) is read from the initrd.
CONFIG_DRM_I915=y

# The DRM core under the driver, and its fbdev console (tty1-tty3) after the EFI framebuffer of
# base: named here because a machine's module list need not name drm itself (kernel-custom
# run 39318902051: qemu-q35 lost its GPU driver without it).
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
