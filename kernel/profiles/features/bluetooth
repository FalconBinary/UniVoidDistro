# kernel/profiles/features/bluetooth: a Bluetooth controller on USB (btusb); the vendor's helper
# (btintel, btrtl, btmtk) is a class the plan adds (class/bt-*).
#
# Off when VH_BLUETOOTH=off (install/lib.sh blacklists bluetooth, btusb, btintel...); then
# this feature is not selected and vh-kconf resolve refuses these modules even if a modalias
# matches them.

CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
# Serial port profile and HID over Bluetooth (headsets, keyboards, controllers).
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
# The USB transport.
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=y
CONFIG_BT_HCIBTUSB_POLL_SYNC=y
