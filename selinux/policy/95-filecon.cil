;; selinux/policy/95-filecon.cil: the labels of the system's files, by path. secilc writes them
;; to the file_contexts that vh-selabel applies (zig/tools/vh-selabel.zig); its regular
;; expressions are the subset vh-selabel understands: literal paths, `.*`, `(/.*)?`, `[...]`,
;; `?`, `+`, `\.`. Unlisted paths take their parent directory's label through the kernel's
;; inheritance, so only what differs from its parent is here. The order does not matter: the
;; longest literal prefix wins, as in libselinux.

;; the roots
(filecon "/" dir (system_u object_r root_t s0r))
(filecon "/.*" any (system_u object_r file_t s0r))
(filecon "/usr" dir (system_u object_r usr_t s0r))
(filecon "/usr/.*" any (system_u object_r usr_t s0r))
(filecon "/usr/bin(/.*)?" any (system_u object_r bin_t s0r))
(filecon "/usr/sbin" symlink (system_u object_r bin_t s0r))
(filecon "/usr/libexec(/.*)?" any (system_u object_r bin_t s0r))
(filecon "/usr/lib(/.*)?" any (system_u object_r lib_t s0r))
(filecon "/usr/lib32(/.*)?" any (system_u object_r lib_t s0r))
(filecon "/usr/lib/ld-linux.*\.so.*" file (system_u object_r ld_so_t s0r))
(filecon "/usr/lib/ld-musl.*\.so.*" file (system_u object_r ld_so_t s0r))
(filecon "/usr/lib/locale(/.*)?" any (system_u object_r locale_t s0r))
(filecon "/usr/lib/getconf(/.*)?" any (system_u object_r bin_t s0r))       ; hard links of /usr/bin/getconf (glibc)
(filecon "/usr/lib/modules(/.*)?" any (system_u object_r modules_object_t s0r))
(filecon "/usr/lib/firmware(/.*)?" any (system_u object_r firmware_t s0r))
(filecon "/usr/share/locale(/.*)?" any (system_u object_r locale_t s0r))
(filecon "/usr/share/zoneinfo(/.*)?" any (system_u object_r zoneinfo_t s0r))
(filecon "/usr/share/fonts(/.*)?" any (system_u object_r fonts_t s0r))
(filecon "/usr/local(/.*)?" any (system_u object_r usr_t s0r))
(filecon "/usr/local/bin(/.*)?" any (system_u object_r bin_t s0r))
(filecon "/usr/local/sbin(/.*)?" any (system_u object_r bin_t s0r))
(filecon "/usr/local/libexec/vh(/.*)?" any (system_u object_r vh_libexec_exec_t s0r))
(filecon "/usr/local/libexec/vh/vh-audit\.d(/.*)?" any (system_u object_r usr_t s0r))
(filecon "/usr/local/lib/vh(/.*)?" any (system_u object_r usr_t s0r))
(filecon "/usr/local/lib/vh/vh_sched\.o" file (system_u object_r sched_object_t s0r))
(filecon "/usr/local/share(/.*)?" any (system_u object_r usr_t s0r))
(filecon "/bin" symlink (system_u object_r bin_t s0r))
(filecon "/sbin" symlink (system_u object_r bin_t s0r))
(filecon "/lib" symlink (system_u object_r lib_t s0r))
(filecon "/lib64" symlink (system_u object_r lib_t s0r))
(filecon "/opt(/.*)?" any (system_u object_r usr_t s0r))

;; the programs that enter a domain
(filecon "/usr/bin/(ba|da)?sh" file (system_u object_r shell_exec_t s0r))
(filecon "/usr/bin/runit" file (system_u object_r init_exec_t s0r))
(filecon "/usr/bin/runsvdir" file (system_u object_r init_exec_t s0r))
(filecon "/usr/bin/runsv" file (system_u object_r init_exec_t s0r))
(filecon "/usr/bin/runit-init" file (system_u object_r initctl_exec_t s0r))
(filecon "/usr/bin/(halt|poweroff|reboot|shutdown)" file (system_u object_r initctl_exec_t s0r))
(filecon "/usr/bin/sv" file (system_u object_r initctl_exec_t s0r))
(filecon "/usr/bin/sv\.runit" file (system_u object_r initctl_exec_t s0r))
(filecon "/usr/local/sbin/vh-init" file (system_u object_r init_exec_t s0r))
(filecon "/usr/local/sbin/vh-stage1" file (system_u object_r init_exec_t s0r))
(filecon "/usr/local/sbin/vh-ctl" file (system_u object_r initctl_exec_t s0r))
(filecon "/etc/runit/[123]" file (system_u object_r init_exec_t s0r))
(filecon "/etc/runit/1\.orig" file (system_u object_r init_exec_t s0r))
(filecon "/etc/runit/ctrlaltdel" file (system_u object_r initrc_exec_t s0r))
(filecon "/etc/runit/core-services(/.*)?" any (system_u object_r initrc_exec_t s0r))
(filecon "/etc/runit/shutdown\.d(/.*)?" any (system_u object_r initrc_exec_t s0r))
(filecon "/etc/sv/[^/]+/(run|finish|check)" file (system_u object_r initrc_exec_t s0r))
(filecon "/etc/sv/[^/]+/log/run" file (system_u object_r initrc_exec_t s0r))
(filecon "/usr/bin/udevd" file (system_u object_r udev_exec_t s0r))
(filecon "/usr/bin/udevadm" file (system_u object_r udev_exec_t s0r))
(filecon "/usr/lib/systemd/systemd-udevd" file (system_u object_r udev_exec_t s0r))
(filecon "/usr/bin/dbus-daemon" file (system_u object_r dbusd_exec_t s0r))
(filecon "/usr/bin/dbus-broker.*" file (system_u object_r dbusd_exec_t s0r))
(filecon "/usr/bin/socklog" file (system_u object_r syslogd_exec_t s0r))
(filecon "/usr/bin/nanoklogd" file (system_u object_r syslogd_exec_t s0r))
(filecon "/usr/bin/svlogd" file (system_u object_r syslogd_exec_t s0r))
(filecon "/usr/bin/vlogger" file (system_u object_r syslogd_exec_t s0r))
(filecon "/usr/bin/agetty" file (system_u object_r getty_exec_t s0r))
(filecon "/usr/bin/login" file (system_u object_r login_exec_t s0r))
(filecon "/usr/bin/doas" file (system_u object_r doas_exec_t s0r))
(filecon "/usr/bin/unix_chkpwd" file (system_u object_r chkpwd_exec_t s0r))
(filecon "/usr/bin/xbps-.*" file (system_u object_r pkg_exec_t s0r))
(filecon "/usr/bin/thor.*" file (system_u object_r pkg_exec_t s0r))
(filecon "/usr/local/sbin/vh-update" file (system_u object_r pkg_exec_t s0r))
(filecon "/usr/local/sbin/vh-pkg" file (system_u object_r pkg_exec_t s0r))
(filecon "/usr/local/sbin/vh-deep-clean" file (system_u object_r pkg_exec_t s0r))
(filecon "/usr/bin/fstrim" file (system_u object_r fsadm_exec_t s0r))
(filecon "/usr/bin/fsck.*" file (system_u object_r fsadm_exec_t s0r))
(filecon "/usr/bin/xfs_.*" file (system_u object_r fsadm_exec_t s0r))
(filecon "/usr/bin/unbound" file (system_u object_r unbound_exec_t s0r))
(filecon "/usr/bin/chronyd" file (system_u object_r chronyd_exec_t s0r))
(filecon "/usr/bin/iwd" file (system_u object_r iwd_exec_t s0r))
(filecon "/usr/libexec/iwd(/.*)?" any (system_u object_r iwd_exec_t s0r))
(filecon "/usr/bin/dhcpcd" file (system_u object_r dhcpcd_exec_t s0r))
(filecon "/usr/bin/bluetoothd" file (system_u object_r bluetoothd_exec_t s0r))
(filecon "/usr/libexec/bluetooth/bluetoothd" file (system_u object_r bluetoothd_exec_t s0r))
(filecon "/usr/bin/seatd" file (system_u object_r seatd_exec_t s0r))
(filecon "/usr/local/bin/refurswm" file (system_u object_r wm_exec_t s0r))
(filecon "/usr/local/bin/refursline" file (system_u object_r bar_exec_t s0r))
(filecon "/usr/bin/pipewire.*" file (system_u object_r pipewire_exec_t s0r))
(filecon "/usr/bin/wireplumber" file (system_u object_r pipewire_exec_t s0r))
(filecon "/usr/local/bin/vh-wlfilter" file (system_u object_r wlfilter_exec_t s0r))
(filecon "/usr/bin/swaylock" file (system_u object_r lock_exec_t s0r))
(filecon "/usr/local/bin/vh-backlight" file (system_u object_r vh_backlight_exec_t s0r))
(filecon "/usr/local/bin/vh-usersh" file (system_u object_r user_shell_exec_t s0r))
(filecon "/usr/local/bin/vh-adminsh" file (system_u object_r admin_shell_exec_t s0r))
(filecon "/usr/local/bin/vh-game-enter" file (system_u object_r game_enter_exec_t s0r))
(filecon "/usr/local/sbin/vh-browser" file (system_u object_r vh_browser_exec_t s0r))
(filecon "/usr/local/libexec/vh/browser-sandbox" file (system_u object_r browser_exec_t s0r))
(filecon "/usr/local/libexec/vh/vh-seccomp" file (system_u object_r vh_seccomp_exec_t s0r))
(filecon "/usr/bin/bwrap" file (system_u object_r browser_exec_t s0r))
(filecon "/usr/lib/firefox/firefox(-bin)?" file (system_u object_r browser_exec_t s0r))
(filecon "/usr/local/sbin/vh-acpid" file (system_u object_r acpid_exec_t s0r))
(filecon "/usr/local/sbin/vh-kconf" file (system_u object_r vh_tools_exec_t s0r))
(filecon "/usr/local/sbin/vh-plan" file (system_u object_r vh_tools_exec_t s0r))
(filecon "/usr/local/sbin/vh-limine-update" file (system_u object_r vh_tools_exec_t s0r))
(filecon "/usr/local/sbin/vh-uki-verify" file (system_u object_r vh_tools_exec_t s0r))
(filecon "/usr/local/sbin/vh-selabel" file (system_u object_r vh_tools_exec_t s0r))
(filecon "/usr/local/sbin/vh-root" file (system_u object_r vh_tools_exec_t s0r))
(filecon "/usr/local/sbin/vh-game" file (system_u object_r vh_tools_exec_t s0r))
(filecon "/usr/local/sbin/vh-sched" file (system_u object_r sched_exec_t s0r))
(filecon "/usr/local/sbin/vh-deadman" file (system_u object_r deadman_exec_t s0r))
(filecon "/usr/local/sbin/vh-(power|bluetooth|suid-strip|net|usb|usb-allow-key|keys|audit|selinux|apply-config)" file (system_u object_r vh_sbin_exec_t s0r))
(filecon "/usr/local/bin/vh-browse" file (system_u object_r bin_t s0r))
(filecon "/usr/local/bin/vh-session" file (system_u object_r bin_t s0r))

;; /etc
(filecon "/etc(/.*)?" any (system_u object_r etc_t s0r))
(filecon "/etc/passwd" file (system_u object_r passwd_file_t s0r))
(filecon "/etc/group" file (system_u object_r passwd_file_t s0r))
(filecon "/etc/passwd-" file (system_u object_r passwd_file_t s0r))
(filecon "/etc/group-" file (system_u object_r passwd_file_t s0r))
(filecon "/etc/shadow.*" file (system_u object_r shadow_t s0r))
(filecon "/etc/gshadow.*" file (system_u object_r shadow_t s0r))
(filecon "/etc/doas\.conf" file (system_u object_r doas_conf_t s0r))
(filecon "/etc/localtime" symlink (system_u object_r etc_t s0r))
(filecon "/etc/resolv\.conf" file (system_u object_r resolv_conf_t s0r))
(filecon "/etc/nftables\.conf" file (system_u object_r nft_conf_t s0r))
(filecon "/etc/vh(/.*)?" any (system_u object_r vh_conf_t s0r))
(filecon "/etc/vh/nft(/.*)?" any (system_u object_r nft_conf_t s0r))
(filecon "/etc/unbound(/.*)?" any (system_u object_r unbound_conf_t s0r))
(filecon "/etc/unbound/var(/.*)?" any (system_u object_r unbound_var_t s0r))
(filecon "/etc/iwd(/.*)?" any (system_u object_r iwd_conf_t s0r))
(filecon "/etc/udev(/.*)?" any (system_u object_r udev_rules_t s0r))
(filecon "/etc/ld\.so\.cache" file (system_u object_r ld_so_cache_t s0r))
(filecon "/etc/mtab" symlink (system_u object_r etc_runtime_t s0r))
(filecon "/etc/hostname" file (system_u object_r etc_t s0r))
(filecon "/etc/adjtime" file (system_u object_r etc_runtime_t s0r))

;; /var
(filecon "/var" dir (system_u object_r var_t s0r))
(filecon "/var/.*" any (system_u object_r var_t s0r))
(filecon "/var/lib(/.*)?" any (system_u object_r var_lib_t s0r))
(filecon "/var/lib/vh(/.*)?" any (system_u object_r vh_state_t s0r))
(filecon "/var/lib/vh/roots/game(/.*)?" any (system_u object_r game_root_t s0r))
(filecon "/var/lib/vh/roots/kbuild(/.*)?" any (system_u object_r kbuild_root_t s0r))
(filecon "/var/lib/vh-browser(/.*)?" any (system_u object_r browser_home_t s0r))
(filecon "/var/lib/sbctl(/.*)?" any (system_u object_r sbctl_keys_t s0r))
(filecon "/var/lib/seedrng(/.*)?" any (system_u object_r seedrng_var_lib_t s0r))
(filecon "/var/lib/chrony(/.*)?" any (system_u object_r chrony_var_lib_t s0r))
(filecon "/var/lib/iwd(/.*)?" any (system_u object_r iwd_var_lib_t s0r))
(filecon "/var/lib/dhcpcd(/.*)?" any (system_u object_r dhcpcd_var_lib_t s0r))
(filecon "/var/lib/bluetooth(/.*)?" any (system_u object_r bluetooth_var_lib_t s0r))
(filecon "/var/lib/thor(/.*)?" any (system_u object_r xbps_db_t s0r))
(filecon "/var/db/xbps(/.*)?" any (system_u object_r xbps_db_t s0r))
(filecon "/var/cache(/.*)?" any (system_u object_r var_cache_t s0r))
(filecon "/var/cache/xbps(/.*)?" any (system_u object_r xbps_cache_t s0r))
(filecon "/var/log(/.*)?" any (system_u object_r var_log_t s0r))
(filecon "/var/log/vh(/.*)?" any (system_u object_r vh_log_t s0r))
(filecon "/var/log/(wtmp|btmp|lastlog).*" file (system_u object_r wtmp_t s0r))
(filecon "/var/tmp(/.*)?" any (system_u object_r var_tmp_t s0r))
(filecon "/var/service" any (system_u object_r var_run_t s0r))
(filecon "/var/run" symlink (system_u object_r var_run_t s0r))
(filecon "/var/lock" symlink (system_u object_r var_run_t s0r))
(filecon "/var/mail(/.*)?" any (system_u object_r var_t s0r))

;; /run (a tmpfs: labelled at every boot by stage 1 after the mounts)
(filecon "/run" dir (system_u object_r var_run_t s0r))
(filecon "/run/.*" any (system_u object_r var_run_t s0r))
(filecon "/run/runit(/.*)?" any (system_u object_r runit_var_run_t s0r))
(filecon "/run/udev(/.*)?" any (system_u object_r udev_var_run_t s0r))
(filecon "/run/dbus(/.*)?" any (system_u object_r dbus_var_run_t s0r))
(filecon "/run/seatd\.sock" socket (system_u object_r seatd_var_run_t s0r))
(filecon "/run/user(/.*)?" any (system_u object_r user_runtime_t s0r))
(filecon "/run/faillock(/.*)?" any (system_u object_r faillock_t s0r))
(filecon "/run/utmp" file (system_u object_r utmp_t s0r))
(filecon "/run/vh(/.*)?" any (system_u object_r vh_run_t s0r))
(filecon "/run/vh/init\.sock" socket (system_u object_r vh_init_sock_t s0r))
(filecon "/run/vh-sandbox(/.*)?" any (system_u object_r vh_sandbox_run_t s0r))
(filecon "/run/chrony(/.*)?" any (system_u object_r chrony_var_run_t s0r))
(filecon "/run/dhcpcd(/.*)?" any (system_u object_r dhcpcd_var_run_t s0r))

;; /tmp, /home, /boot, /root
(filecon "/tmp" dir (system_u object_r tmp_t s0r))
(filecon "/tmp/.*" any (system_u object_r tmp_t s0r))
(filecon "/home" dir (system_u object_r home_root_t s0r))
(filecon "/home/[^/]+" dir (system_u object_r user_home_dir_t s0r))
(filecon "/home/[^/]+/.*" any (system_u object_r user_home_t s0r))
(filecon "/home/xfer(/.*)?" any (system_u object_r xfer_t s0r))
(filecon "/root(/.*)?" any (system_u object_r admin_home_t s0r))
(filecon "/root/vh(/.*)?" any (system_u object_r vh_repo_t s0r))       ; the system's own, not the admin's files: the tools read it (neverallow #9 keeps daemons out of home_type)
(filecon "/boot(/.*)?" any (system_u object_r boot_t s0r))
(filecon "/boot/efi" dir (system_u object_r efi_t s0r))
(filecon "/mnt(/.*)?" any (system_u object_r root_t s0r))
(filecon "/media(/.*)?" any (system_u object_r root_t s0r))
(filecon "/srv(/.*)?" any (system_u object_r var_t s0r))

;; /dev (devtmpfs: labelled at every boot after the mounts; udev keeps the labels of what it creates)
(filecon "/dev" dir (system_u object_r device_t s0r))
(filecon "/dev/.*" any (system_u object_r device_t s0r))
(filecon "/dev/null" char (system_u object_r null_device_t s0r))
(filecon "/dev/zero" char (system_u object_r zero_device_t s0r))
(filecon "/dev/full" char (system_u object_r zero_device_t s0r))
(filecon "/dev/random" char (system_u object_r random_device_t s0r))
(filecon "/dev/urandom" char (system_u object_r urandom_device_t s0r))
(filecon "/dev/console" char (system_u object_r console_device_t s0r))
(filecon "/dev/tty" char (system_u object_r tty_device_t s0r))
(filecon "/dev/tty[0-9]+" char (system_u object_r tty_device_t s0r))
(filecon "/dev/ttyS[0-9]+" char (system_u object_r tty_device_t s0r))
(filecon "/dev/ttyAMA[0-9]+" char (system_u object_r tty_device_t s0r))
(filecon "/dev/hvc[0-9]+" char (system_u object_r tty_device_t s0r))
(filecon "/dev/ptmx" char (system_u object_r ptmx_t s0r))
(filecon "/dev/pts(/.*)?" any (system_u object_r devpts_t s0r))
(filecon "/dev/kmsg" char (system_u object_r kmsg_device_t s0r))
(filecon "/dev/dri(/.*)?" any (system_u object_r dri_device_t s0r))
(filecon "/dev/input(/.*)?" any (system_u object_r input_device_t s0r))
(filecon "/dev/snd(/.*)?" any (system_u object_r sound_device_t s0r))
(filecon "/dev/video[0-9]+" char (system_u object_r video_device_t s0r))
(filecon "/dev/media[0-9]+" char (system_u object_r video_device_t s0r))
(filecon "/dev/bus/usb(/.*)?" any (system_u object_r usb_device_t s0r))
(filecon "/dev/rfkill" char (system_u object_r rfkill_device_t s0r))
(filecon "/dev/tpm[0-9]+" char (system_u object_r tpm_device_t s0r))
(filecon "/dev/tpmrm[0-9]+" char (system_u object_r tpm_device_t s0r))
(filecon "/dev/watchdog[0-9]*" char (system_u object_r watchdog_device_t s0r))
(filecon "/dev/kvm" char (system_u object_r kvm_device_t s0r))
(filecon "/dev/rtc[0-9]*" char (system_u object_r clock_device_t s0r))
(filecon "/dev/(sd|nvme|vd|mmcblk)[a-z0-9]+(p[0-9]+)?" block (system_u object_r fixed_disk_device_t s0r))
(filecon "/dev/sr[0-9]+" block (system_u object_r removable_device_t s0r))
(filecon "/dev/zram[0-9]+" block (system_u object_r zram_device_t s0r))
(filecon "/dev/dm-[0-9]+" block (system_u object_r mapper_device_t s0r))
(filecon "/dev/mapper(/.*)?" any (system_u object_r mapper_device_t s0r))
(filecon "/dev/loop[0-9]*" block (system_u object_r loop_device_t s0r))
(filecon "/dev/loop-control" char (system_u object_r loop_device_t s0r))
(filecon "/dev/mem" char (system_u object_r memory_device_t s0r))
(filecon "/dev/port" char (system_u object_r memory_device_t s0r))
(filecon "/dev/cpu(/.*)?" any (system_u object_r cpu_device_t s0r))
(filecon "/dev/fuse" char (system_u object_r fuse_device_t s0r))
(filecon "/dev/autofs" char (system_u object_r autofs_device_t s0r))
(filecon "/dev/net(/.*)?" any (system_u object_r net_device_t s0r))
(filecon "/dev/shm(/.*)?" any (system_u object_r tmpfs_t s0r))
(filecon "/dev/log" socket (system_u object_r devlog_t s0r))
(filecon "/dev/mqueue(/.*)?" any (system_u object_r mqueue_t s0r))
(filecon "/dev/hugepages(/.*)?" any (system_u object_r hugetlbfs_t s0r))
