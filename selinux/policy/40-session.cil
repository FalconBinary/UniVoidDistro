;; selinux/policy/40-session.cil: the people. The everyday user on tty1 (user_t and the domains
;; of the desktop), the admin on tty2 (admin_t, who becomes sysadm_t through doas), the gaming
;; session on tty3 (game_t). No unconfined domain: a person's shell is a domain with a list.

;; a person's shell and what they run in it (a terminal, git, ssh, the clipboard tools)
(macro user_domain ((type d) (type home_dir) (type home))
    (call domain_type (d))
    (typeattributeset userdomain d)
    (call net_client (d))
    (allow d self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid)))   ; the user's own files and processes
    (allow d self (process (setexec setrlimit setsched)))
    (allow d self (icmp_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))   ; ping (ping_group_range)
    (allow d port_type (tcp_socket (name_connect)))
    (call manage_files (d home_dir))
    (call manage_files (d home))
    (typetransition d home_dir dir home)
    (typetransition d home_dir file home)
    (typetransition d home_dir lnk_file home)
    (typetransition d home_dir sock_file home)
    (typetransition d home_dir fifo_file home)
    (call manage_files (d tmp_t))
    (call manage_files (d var_tmp_t))
    (call manage_files (d user_runtime_t))
    (call manage_files (d tmpfs_t))
    (call exec_files (d bin_t))
    (call exec_files (d shell_exec_t))
    (call exec_files (d usr_t))
    (allow d home (file (execute)))                 ; noexec /home is the mount's job; a VH_DEV_DIR may run its builds
    (allow d tty_device_t chr_rw)
    (allow d console_device_t (chr_file (read write getattr ioctl)))
    (allow d devpts_t (dir (search getattr read)))
    (allow d devpts_t (chr_file (ioctl read write getattr setattr lock append open)))
    (allow d ptmx_t (chr_file (ioctl read write getattr lock append open)))
    (allow d dri_device_t (dir (search getattr read open)))
    (allow d dri_device_t (chr_file (ioctl read write getattr lock append open map)))   ; the render node (group render)
    (allow d sound_device_t (chr_file (getattr)))
    (allow d var_run_t (dir (read)))
    (allow d var_lib_t (dir (read)))
    (allow d etc_runtime_t file_r)
    (allow d resolv_conf_t file_r)
    (allow d vh_conf_t file_r)
    (allow d vh_conf_t dir_r)
    (allow d vh_run_t file_r)
    (allow d vh_run_t dir_r)
    (allow d xbps_db_t file_r)
    (allow d xbps_db_t dir_r)
    (allow d sysctl_type (dir (search)))
    (allow d sysctl_type (file (read getattr open)))
    (allow d domain (dir (search getattr)))         ; its own processes in /proc (hidepid keeps the rest away)
    (allow d domain (file (read getattr open)))
    (allow d domain (lnk_file (read getattr)))
    (allow d d (process (signal sigkill sigstop signull getsched setsched getattr getsession getpgid setpgid)))
    (allow d d (unix_stream_socket (connectto)))
    (allow d d (unix_dgram_socket (sendto)))
    (allow d d (fd (use)))
    (allow d d (key (search view read write link setattr create)))
    (call domtrans (d doas_exec_t doas_t))
    (call domtrans (d chkpwd_exec_t chkpwd_t))
    (call domtrans (d vh_backlight_exec_t backlight_t)))

;; ---------------------------------------------------------------- the everyday user (tty1)
(type user_t)
(call user_domain (user_t user_home_dir_t user_home_t))
(roletype user_r user_t)
(call manage_files (user_t xfer_t))
(call dbus_client (user_t))
(allow user_t vh_sandbox_run_t (dir (search getattr)))
;; the session: vh-session starts RefursWM; RefursWM's launcher starts the rest
(type wm_t)
(type wm_exec_t) (call executable (wm_exec_t))                  ; refurswm
(type bar_t)
(type bar_exec_t) (call executable (bar_exec_t))                ; refursline
(type pipewire_t)
(type pipewire_exec_t) (call executable (pipewire_exec_t))      ; pipewire, pipewire-pulse, wireplumber
(type wlfilter_t)
(type wlfilter_exec_t) (call executable (wlfilter_exec_t))      ; vh-wlfilter
(type lock_t)
(type lock_exec_t) (call executable (lock_exec_t))              ; swaylock
(call domtrans (user_t wm_exec_t wm_t))
(call read_files (wm_t udev_rules_t))           ; libudev's hwdb.bin in /etc/udev
(roletype user_r wm_t)
(roletype user_r bar_t)
(roletype user_r pipewire_t)
(roletype user_r wlfilter_t)
(roletype user_r lock_t)

;; the compositor: KMS and the input devices (through seatd's file descriptors), the Wayland
;; socket, the programs it launches in the user's domain
(call domain_type (wm_t))
(typeattributeset userdomain wm_t)
(allow wm_t self (process (setrlimit setsched setexec)))
(allow wm_t self (capability (sys_nice)))
(allow wm_t seatd_t (unix_stream_socket (connectto)))
(allow wm_t seatd_var_run_t (dir (search getattr)))
(allow wm_t seatd_var_run_t sock_w)
(allow wm_t seatd_t (fd (use)))
(allow wm_t dri_device_t (chr_file (ioctl read write getattr lock append open map)))
(allow wm_t dri_device_t (dir (search getattr read open)))
(allow wm_t self (netlink_kobject_uevent_socket (create bind getattr setopt read write)))   ; libudev's monitor: the outputs and the input devices that come and go
(allow wm_t input_device_t (chr_file (ioctl read write getattr lock append open)))
(allow wm_t tty_device_t (chr_file (ioctl read write getattr open)))
(allow wm_t console_device_t (chr_file (ioctl read write getattr open)))
(call manage_files (wm_t user_runtime_t))
(call manage_files (wm_t tmpfs_t))
(call read_files (wm_t user_home_t))
(allow wm_t user_home_dir_t (dir (search getattr)))
(call manage_files (wm_t user_home_t))                            ; the shader cache under ~/.cache
(allow wm_t sysfs_t (file (read getattr open)))
(allow wm_t udev_var_run_t (dir (search getattr read)))
(allow wm_t udev_var_run_t (file (read getattr open)))              ; libinput reads udev's database
(call exec_files (wm_t bin_t))
(call exec_files (wm_t shell_exec_t))
(call exec_files (wm_t usr_t))
(allow wm_t user_t (process (transition sigkill signal)))
(allow user_t wm_t (fd (use)))
(allow user_t wm_t (process (sigchld)))
(allow user_t wm_t (unix_stream_socket (connectto read write getattr)))
(typetransition wm_t bin_t process user_t)
(typetransition wm_t shell_exec_t process user_t)
(allow user_t bin_t (file (entrypoint)))
(allow user_t shell_exec_t (file (entrypoint)))
(allow user_t usr_t (file (entrypoint)))
(allow wm_t user_t (process (siginh rlimitinh noatsecure)))
(allow bar_t user_t (process (siginh rlimitinh noatsecure)))
(call domtrans (wm_t bar_exec_t bar_t))
(call domtrans (wm_t pipewire_exec_t pipewire_t))
(call domtrans (wm_t wlfilter_exec_t wlfilter_t))
(call domtrans (wm_t lock_exec_t lock_t))
(allow wm_t user_t (fd (use)))
(allow wm_t user_t (fifo_file (read write getattr)))

;; every client of the compositor: the Wayland socket in /run/user/UID
(macro wayland_client ((type d))
    (allow d user_runtime_t (dir (search getattr)))
    (allow d user_runtime_t sock_w)
    (allow d wm_t (unix_stream_socket (connectto)))
    (allow wm_t d (fd (use)))
    (allow wm_t d (unix_stream_socket (read write getattr)))
    (allow d wm_t (fd (use)))
    (allow d tmpfs_t (file (read write getattr map)))
    (allow d dri_device_t (chr_file (ioctl read write getattr lock append open map)))
    ;; what the session's programs inherit from vh-session: the log in /run/user/UID and the tty of the login
    (allow d user_t (fd (use)))
    (allow d user_runtime_t (file (append write getattr)))
    (allow d tty_device_t (chr_file (read write getattr ioctl))))
(call wayland_client (user_t))

;; the bar: sysfs, the clock, the system bus (iwd, bluez), the wallpapers, its launcher broker
(call domain_type (bar_t))
(typeattributeset userdomain bar_t)
(call wayland_client (bar_t))
(call dbus_client (bar_t))
(allow bar_t self (process (setrlimit)))
(call rw_files (bar_t user_home_t))
(allow bar_t user_home_dir_t (dir (search getattr)))
(allow bar_t sysfs_t (file (read getattr open)))
(allow bar_t vh_run_t file_r)
(allow bar_t vh_run_t dir_r)
(call exec_files (bar_t bin_t))
(call exec_files (bar_t shell_exec_t))
(call exec_files (bar_t usr_t))
(typetransition bar_t bin_t process user_t)
(typetransition bar_t shell_exec_t process user_t)
(allow bar_t user_t (process (transition)))
(allow user_t bar_t (fd (use)))
(allow user_t bar_t (process (sigchld)))
(allow user_t bar_t (fifo_file (read write getattr)))
(allow user_t bar_t (unix_stream_socket (read write getattr)))
(call domtrans (bar_t doas_exec_t doas_t))

;; audio: PipeWire, WirePlumber, pipewire-pulse (the browser's restricted socket)
(call domain_type (pipewire_t))
(typeattributeset userdomain pipewire_t)
(call wayland_client (pipewire_t))
(call dbus_client (pipewire_t))
(allow pipewire_t self (process (setsched setrlimit)))
(allow pipewire_t self (capability (sys_nice ipc_lock)))
(allow pipewire_t sound_device_t (chr_file (ioctl read write getattr lock append open map)))
(allow pipewire_t sound_device_t (dir (search getattr read open)))      ; ALSA enumerates /dev/snd
(allow pipewire_t video_device_t (chr_file (ioctl read write getattr lock append open map)))
(call manage_files (pipewire_t user_runtime_t))
(call manage_files (pipewire_t vh_sandbox_run_t))
(call manage_files (pipewire_t tmpfs_t))
(call rw_files (pipewire_t user_home_t))
(allow pipewire_t user_home_dir_t (dir (search getattr)))
(allow pipewire_t sysfs_t (file (read getattr open)))
(allow pipewire_t udev_var_run_t (dir (search getattr read)))
(allow pipewire_t udev_var_run_t (file (read getattr open)))
(allow pipewire_t self (netlink_kobject_uevent_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
(allow pipewire_t pipewire_t (unix_stream_socket (connectto)))
(allow user_t pipewire_t (unix_stream_socket (connectto)))
(allow pipewire_t user_t (fd (use)))
(allow pipewire_t user_t (unix_stream_socket (read write getattr)))
(call exec_files (pipewire_t pipewire_exec_t))

;; the Wayland filter for the sandboxes: the user's socket on one side, /run/vh-sandbox on the other
(call domain_type (wlfilter_t))
(typeattributeset userdomain wlfilter_t)
(call wayland_client (wlfilter_t))
(call manage_files (wlfilter_t vh_sandbox_run_t))
(allow wlfilter_t self (process (setrlimit)))

;; the screen lock: the session lock protocol, the password through unix_chkpwd
(call domain_type (lock_t))
(typeattributeset userdomain lock_t)
(call wayland_client (lock_t))
(allow lock_t self (process (setrlimit setsched)))
(allow lock_t self (capability (ipc_lock)))
(call read_files (lock_t user_home_t))
(allow lock_t user_home_dir_t (dir (search getattr)))
(allow lock_t var_run_t (dir (search)))
(call domtrans (lock_t chkpwd_exec_t chkpwd_t))
(allow lock_t user_t (fd (use)))
(allow lock_t user_t (process (sigchld)))
(allow user_t lock_t (process (signal sigkill)))
(call domtrans (user_t lock_exec_t lock_t))

;; the backlight: the one sysfs write the person may do, in its own domain
(type backlight_t)
(type vh_backlight_exec_t) (call executable (vh_backlight_exec_t))
(call domain_type (backlight_t))
(roletype user_r backlight_t)
(roletype admin_r backlight_t)
(allow backlight_t sysfs_t (file (ioctl read write getattr open)))
(call exec_files (backlight_t bin_t))
(call exec_files (backlight_t shell_exec_t))
(allow backlight_t userdomain (fd (use)))
(allow backlight_t userdomain (process (sigchld)))
(allow backlight_t userdomain (fifo_file (read write getattr)))
(allow backlight_t devpts_t (chr_file (read write getattr ioctl)))
(allow backlight_t tty_device_t (chr_file (read write getattr ioctl)))

;; ---------------------------------------------------------------- the browser sandbox
;; doas -> vh-browser (root: the sandbox directories, the browser user) -> browser-sandbox
;; (bwrap as the browser user, a user namespace) -> firefox. browser_t is the whole of it.
(type vh_browser_t)
(type vh_browser_exec_t) (call executable (vh_browser_exec_t))      ; /usr/local/sbin/vh-browser
(type browser_t)
(type browser_exec_t) (call executable (browser_exec_t))            ; /usr/local/libexec/vh/browser-sandbox, bwrap, firefox
(type vh_seccomp_exec_t) (call executable (vh_seccomp_exec_t))      ; vh-seccomp: the filter generator
(call domain_type (vh_browser_t))
(roletype user_r vh_browser_t)
(allow vh_browser_t self (capability (setuid setgid chown dac_override dac_read_search fowner fsetid kill sys_resource sys_admin)))
(allow vh_browser_t self (process (setexec setrlimit)))
(allow vh_browser_t self (netlink_netfilter_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))   ; nft add element browser_lan
(allow vh_browser_t self (capability (net_admin)))
(call manage_files (vh_browser_t tmp_t))
(call manage_files (vh_browser_t browser_home_t))
(call manage_files (vh_browser_t xfer_t))
(call manage_files (vh_browser_t vh_sandbox_run_t))
(call read_files (vh_browser_t vh_conf_t))
(call read_files (vh_browser_t nft_conf_t))
(call exec_files (vh_browser_t bin_t))
(call exec_files (vh_browser_t shell_exec_t))
(call exec_files (vh_browser_t vh_seccomp_exec_t))
(call exec_files (vh_browser_t vh_sbin_exec_t))
(allow vh_browser_t home_type (dir (search getattr)))
(allow vh_browser_t user_runtime_t (dir (search getattr)))
(allow vh_browser_t doas_t (fd (use)))
(allow vh_browser_t doas_t (fifo_file (read write getattr)))
(allow vh_browser_t doas_t (process (sigchld)))
(allow vh_browser_t devpts_t (chr_file (read write getattr ioctl)))
(allow vh_browser_t tty_device_t (chr_file (read write getattr ioctl)))
(allow vh_browser_t domain (dir (search getattr)))
(allow vh_browser_t domain (file (read getattr open)))
(allow vh_browser_t domain (process (signal signull)))
(call domtrans (vh_browser_t browser_exec_t browser_t))
(allow vh_browser_t browser_t (process (siginh rlimitinh noatsecure signal sigkill)))

(call domain_type (browser_t))
(roletype user_r browser_t)
(call net_client (browser_t))
(allow browser_t http_port_t (tcp_socket (name_connect)))
(allow browser_t self (process (execmem execstack setrlimit setsched setexec)))
(allow browser_t self (capability (setuid setgid sys_chroot sys_admin dac_override chown fowner kill net_admin)))   ; bwrap outside the namespace: none in effect (the browser user), listed for the namespace setup
(allow browser_t self (cap_userns (chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap net_admin sys_chroot sys_admin mknod)))
(allow browser_t self (user_namespace (create)))
(typeattributeset mount_domain browser_t)
(allow browser_t fs_type (filesystem (mount remount unmount getattr)))
(allow browser_t fs_t (filesystem (getattr)))
(allow browser_t file_type (dir (mounton)))
(allow browser_t file_type (file (mounton)))
(allow browser_t tmpfs_t (filesystem (mount remount unmount getattr)))
(allow browser_t proc_t (filesystem (mount getattr)))
(allow browser_t device_t (filesystem (mount getattr)))
(call manage_files (browser_t browser_home_t))
(call manage_files (browser_t xfer_t))
(call manage_files (browser_t tmp_t))
(call manage_files (browser_t tmpfs_t))
(allow browser_t vh_sandbox_run_t (dir (search getattr read)))
(allow browser_t vh_sandbox_run_t sock_w)
(allow browser_t wlfilter_t (unix_stream_socket (connectto)))
(allow browser_t pipewire_t (unix_stream_socket (connectto)))
(allow wlfilter_t browser_t (fd (use)))
(allow pipewire_t browser_t (fd (use)))
(allow browser_t dri_device_t (chr_file (ioctl read write getattr lock append open map)))
(allow browser_t vh_conf_t file_r)
(allow browser_t vh_conf_t dir_r)
(allow browser_t resolv_conf_t file_r)
(call exec_files (browser_t bin_t))
(call exec_files (browser_t shell_exec_t))
(call exec_files (browser_t browser_exec_t))
(call exec_files (browser_t usr_t))
(call exec_files (browser_t vh_seccomp_exec_t))
(allow browser_t home_type (dir (search getattr)))
(allow browser_t vh_browser_t (fd (use)))
(allow browser_t vh_browser_t (process (sigchld)))
(allow browser_t vh_browser_t (fifo_file (read write getattr)))
(allow browser_t devpts_t (chr_file (read write getattr ioctl)))
(allow browser_t sysctl_type (dir (search)))
(allow browser_t sysctl_type (file (read getattr open)))
(allow browser_t domain (dir (search getattr)))
(allow browser_t browser_t (process (signal sigkill sigstop signull getsched setsched getattr getsession getpgid setpgid share)))
(allow browser_t browser_t (unix_stream_socket (connectto)))
(allow browser_t browser_t (unix_dgram_socket (sendto)))
(allow browser_t browser_t (fd (use)))
(allow browser_t browser_t (key (search view read write link setattr create)))
(allow browser_t browser_t (shm (create destroy getattr setattr read write associate unix_read unix_write lock)))

;; ---------------------------------------------------------------- the admin (tty2)
(type admin_t)
(call user_domain (admin_t admin_home_t admin_home_t))
(roletype admin_r admin_t)
(call dbus_client (admin_t))
(allow admin_t vh_state_t dir_r)
(allow admin_t vh_state_t file_r)
(allow admin_t var_log_t dir_r)
(allow admin_t var_log_t file_r)                   ; the logs are readable by root only anyway
(call exec_files (admin_t vh_tools_exec_t))
(call exec_files (admin_t vh_sbin_exec_t))
(call exec_files (admin_t init_exec_t))
(call exec_files (admin_t initctl_exec_t))
(call exec_files (admin_t sched_exec_t))
(allow admin_t init_t (unix_stream_socket (connectto)))        ; vh-ctl status (root only at the socket)
(allow admin_t vh_init_sock_t (sock_file (getattr)))

;; ---------------------------------------------------------------- the gaming session (tty3)
(type game_t)
(call user_domain (game_t game_root_t game_root_t))
(roletype game_r game_t)
(allow game_t self (process (execmem execstack execheap)))
(allow game_t self (user_namespace (create)))
(allow game_t self (cap_userns (chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap net_admin sys_chroot sys_admin mknod sys_nice sys_resource)))
(allow game_t self (capability (setuid setgid sys_chroot sys_admin dac_override chown fowner kill sys_nice sys_resource)))
(typeattributeset mount_domain game_t)
(allow game_t fs_type (filesystem (mount remount unmount getattr)))
(allow game_t fs_t (filesystem (getattr)))
(allow game_t file_type (dir (mounton)))
(allow game_t file_type (file (mounton)))
(allow game_t input_device_t (chr_file (ioctl read write getattr lock append open)))
(allow game_t sound_device_t (chr_file (ioctl read write getattr lock append open map)))
(allow game_t game_root_t (file (execute execute_no_trans execmod)))
(call manage_files (game_t vh_state_t))
(allow game_t seatd_t (unix_stream_socket (connectto)))
(allow game_t seatd_var_run_t (dir (search getattr)))
(allow game_t seatd_var_run_t sock_w)
(allow game_t seatd_t (fd (use)))
(allow game_t game_t (unix_stream_socket (connectto)))
(allow game_t game_t (shm (create destroy getattr setattr read write associate unix_read unix_write lock)))
(allow game_t udev_var_run_t (dir (search getattr read)))
(allow game_t udev_var_run_t (file (read getattr open)))
(allow game_t sysfs_t (file (read getattr open)))
(call dbus_client (game_t))
(allow game_t login_t (fd (use)))

;; ---------------------------------------------------------------- seatd: the seat, for the compositor and the game
(type seatd_t)
(type seatd_exec_t) (call executable (seatd_exec_t))
(call daemon_type (seatd_t seatd_exec_t))
(allow seatd_t self (capability (chown dac_override fowner fsetid setgid setuid sys_tty_config sys_admin)))
(call manage_files (seatd_t seatd_var_run_t))
(call manage_files (seatd_t var_run_t))
(typetransition seatd_t var_run_t sock_file "seatd.sock" seatd_var_run_t)
(allow seatd_t dri_device_t (chr_file (ioctl read write getattr setattr lock append open)))
(allow seatd_t dri_device_t (dir (search getattr read open)))
(allow seatd_t input_device_t (chr_file (ioctl read write getattr setattr lock append open)))
(allow seatd_t input_device_t (dir (search getattr read open)))
(allow seatd_t tty_device_t (chr_file (ioctl read write getattr setattr lock append open)))
(allow seatd_t console_device_t (chr_file (ioctl read write getattr setattr lock append open)))
(allow seatd_t sysfs_t (file (read getattr open)))
(allow seatd_t userdomain (fd (use)))
(allow seatd_t userdomain (unix_stream_socket (read write getattr)))
(allow seatd_t userdomain (process (signal)))
(allow seatd_t udev_var_run_t (dir (search getattr read)))
(allow seatd_t udev_var_run_t (file (read getattr open)))
