;; selinux/policy/10-init.cil: the kernel, PID 1 and stage 1. The policy is loaded by stage 1
;; (vh-init, or vh-stage1 under runit) while everything still runs as kernel_t, so kernel_t is an
;; init domain too: init_t is what the manager, runsvdir and runit's scripts become on exec.
;; After the load init sets secure_mode_policyload: from then on nothing in the system can load
;; another policy, switch enforcing off or change a boolean until the next boot (Fedora leaves
;; this boolean off).

(typeattributeset domain (kernel_t init_t))
(typeattributeset init_domain (kernel_t init_t))
(roletype system_r kernel_t)
(roletype system_r init_t)
(call domain_type (kernel_t))
(call domain_type (init_t))
(type init_exec_t) (call executable (init_exec_t))           ; vh-init, vh-stage1, runit, runsvdir, runsv, /etc/runit/{1,2,3}
(type initrc_t)
(type initrc_exec_t) (call executable (initrc_exec_t))       ; /etc/sv/*/run, log/run, check, finish, /etc/runit/core-services, ctrlaltdel
(type shell_exec_t) (call executable (shell_exec_t))         ; /bin/sh, bash, dash
(type bin_exec_t) (call executable (bin_exec_t))             ; (unused name kept for the lint: ordinary programs are bin_t)
(call domtrans (kernel_t init_exec_t init_t))
(call domtrans (init_t init_exec_t init_t))

;; the boot: everything of the system's own files, every mount, the sysctls, the modules, the
;; firewall, the devices. Not: the people's files, the secrets of other domains (shadow is
;; login's, the Wi-Fi passphrases iwd's, the Secure Boot keys the package manager's).
(macro init_rules ((type d))
    (allow d self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap linux_immutable net_bind_service net_broadcast net_admin net_raw ipc_lock ipc_owner sys_module sys_chroot sys_admin sys_boot sys_nice sys_resource sys_time sys_tty_config mknod lease audit_write audit_control setfcap)))
    (allow d self (capability2 (mac_admin syslog wake_alarm block_suspend audit_read perfmon bpf)))
    (allow d self (process (setexec setfscreate setcurrent setkeycreate setsockcreate execmem)))
    (allow d self (netlink_route_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto name_bind nlmsg_read nlmsg_write)))
    (allow d self (netlink_netfilter_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto name_bind)))
    (allow d self (netlink_kobject_uevent_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto name_bind)))
    (allow d self (netlink_audit_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto name_bind nlmsg_read nlmsg_write nlmsg_relay nlmsg_readpriv nlmsg_tty_audit)))
    (allow d self inet_client)
    (allow d self udp_all)
    (allow d self (bpf (map_create map_read map_write prog_load prog_run)))
    (allow d self (user_namespace (create)))
    (allow d self (system (module_request syslog_read syslog_mod syslog_console)))
    (allow d kernel_t (system (module_request syslog_read syslog_mod syslog_console firmware_load)))
    (allow d modules_object_t (system (module_load)))
    (allow d modules_object_t (file (read getattr open map)))
    (allow d modules_object_t (dir (search read getattr open)))
    (allow d firmware_t (file (read getattr open map)))
    (allow d firmware_t (dir (search read getattr open)))
    ;; the file systems: mount, remount, unmount everything the system mounts
    (typeattributeset mount_domain d)
    (allow d fs_type (filesystem (mount remount unmount getattr relabelfrom relabelto associate)))
    (allow d fs_t (filesystem (mount remount unmount getattr relabelfrom relabelto)))
    (allow d file_type (dir (mounton)))
    (allow d file_type (file (mounton)))
    ;; the system's own files, all of them but the secrets and the people's
    (call manage_files (d root_t))
    (call manage_files (d etc_t))
    (call manage_files (d etc_runtime_t))
    (call manage_files (d passwd_file_t))
    (call manage_files (d var_t))
    (call manage_files (d var_lib_t))
    (call manage_files (d var_log_t))
    (call manage_files (d wtmp_t))
    (call manage_files (d var_run_t))
    (call manage_files (d var_cache_t))
    (call manage_files (d var_tmp_t))
    (call manage_files (d tmp_t))
    (call manage_files (d tmpfs_t))
    (call manage_files (d utmp_t))
    (call manage_files (d runit_var_run_t))
    (call manage_files (d udev_var_run_t))
    (call manage_files (d vh_run_t))
    (call manage_files (d vh_init_sock_t))
    (call manage_files (d vh_sandbox_run_t))
    (call manage_files (d vh_state_t))
    (call manage_files (d vh_log_t))
    (call manage_files (d vh_conf_t))
    (call manage_files (d faillock_t))
    (call manage_files (d user_runtime_t))
    (call manage_files (d devlog_t))
    (call manage_files (d seedrng_var_lib_t))
    (call manage_files (d boot_t))
    (call manage_files (d efi_t))
    (call read_files (d home_root_t))
    (call read_files (d user_home_dir_t))
    (allow d home_type (dir (getattr search)))
    (call read_files (d xfer_t))
    (call read_files (d browser_home_t))
    (call read_files (d game_root_t))
    (call read_files (d kbuild_root_t))
    (call read_files (d nft_conf_t))
    (call read_files (d resolv_conf_t))
    (call read_files (d unbound_conf_t))
    (call read_files (d iwd_conf_t))
    (call read_files (d udev_rules_t))
    (call read_files (d doas_conf_t))
    (call read_files (d xbps_db_t))
    (call read_files (d sched_object_t))
    (call exec_files (d bin_t))
    (call exec_files (d shell_exec_t))
    (call exec_files (d usr_t))
    (allow d exec_type file_x)
    (allow d exec_type dir_r)
    (allow d file_type (file (relabelfrom relabelto)))
    (allow d file_type (dir (relabelfrom relabelto)))
    (allow d file_type (lnk_file (relabelfrom relabelto)))
    (allow d file_type (chr_file (relabelfrom relabelto)))
    (allow d file_type (blk_file (relabelfrom relabelto)))
    (allow d file_type (sock_file (relabelfrom relabelto)))
    (allow d file_type (fifo_file (relabelfrom relabelto)))
    (typeattributeset can_relabel d)
    ;; the devices: nodes made and set up (udev's work before udev), zram's swap signature, the console
    (allow d device_node (chr_file (ioctl read write create getattr setattr lock append open unlink link rename relabelfrom relabelto)))
    (allow d device_node (blk_file (ioctl read write create getattr setattr lock append open unlink link rename relabelfrom relabelto)))
    (call manage_files (d device_t))
    (allow d devpts_t (dir (search getattr read)))
    (allow d devpts_t (chr_file (read write getattr ioctl setattr)))
    ;; the kernel's knobs: every sysctl, sysfs, cgroup2, bpffs, efivarfs, securityfs
    (allow d sysctl_type (dir (search read getattr)))
    (allow d sysctl_type (file (read write getattr setattr open)))
    (allow d sysfs_t (dir (ioctl read write getattr setattr lock open search add_name remove_name)))
    (allow d sysfs_t (file (ioctl read write getattr setattr lock append open)))
    (allow d sysfs_t (lnk_file (read getattr)))
    (call manage_files (d cgroup_t))
    (call manage_files (d bpf_t))
    (allow d efivarfs_t (dir (search read getattr write add_name remove_name)))
    (allow d efivarfs_t (file (read write getattr setattr create unlink open)))
    (allow d securityfs_t (dir (search read getattr)))
    (allow d securityfs_t (file (read write getattr open)))
    (allow d proc_t (dir (search read getattr)))
    (allow d proc_t (file (read write getattr open)))
    (allow d proc_kmsg_t (file (read getattr open)))
    (allow d kmsg_device_t (chr_file (read write getattr open append)))
    ;; every process of the system: signals, the view of /proc, the shutdown
    (allow d domain (process (signal sigkill sigstop signull sigchld getsched setsched getattr getsession getpgid setpgid)))
    (allow d domain (dir (search read getattr)))
    (allow d domain (file (read getattr open)))
    (allow d domain (lnk_file (read getattr)))
    (allow d domain (fd (use)))
    (allow d domain (fifo_file (read write getattr ioctl)))
    (allow d domain (unix_stream_socket (read write getattr ioctl)))
    (allow d domain (key (search view)))
    ;; the network as stage 1 sets it up: lo, the firewall
    (allow d self (packet_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
    (allow d self (rawip_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
    (allow d self (icmp_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
    (allow d node_t (tcp_socket (node_bind)))
    (allow d node_t (udp_socket (node_bind)))
    ;; selinuxfs: what the load and the audit of the policy need; the rest is below the boolean
    (allow d security_t (dir (search read getattr)))
    (allow d security_t (file (read write getattr open)))
    (allow d security_t (security (compute_av compute_create compute_member check_context compute_relabel compute_user read_policy validate_trans))))

(call init_rules (kernel_t))
(call init_rules (init_t))
;; the kernel's own threads (kernel_t): firmware, the module signatures, the keys
(allow kernel_t self (system (firmware_load module_load x509_certificate_load)))
(allow kernel_t kernel_t (key (search view read write link setattr create)))
(allow kernel_t unlabeled_t (dir (search read getattr)))
(allow kernel_t unlabeled_t (file (read getattr open)))
;; the initramfs (unlabeled, before the policy) hands its mounts and files to the root
(allow init_domain unlabeled_t (dir (ioctl read write getattr setattr lock open search add_name remove_name reparent rmdir mounton)))
(allow init_domain unlabeled_t (file (ioctl read write getattr setattr lock append open unlink rename relabelfrom mounton)))
(allow init_domain unlabeled_t (lnk_file (read getattr unlink relabelfrom)))
(allow init_domain unlabeled_t (chr_file (read write getattr setattr open ioctl relabelfrom)))
(allow init_domain unlabeled_t (blk_file (read write getattr open ioctl relabelfrom)))
(allow init_domain unlabeled_t (sock_file (getattr unlink relabelfrom)))
(allow init_domain unlabeled_t (fifo_file (getattr unlink relabelfrom)))
(allow init_domain unlabeled_t (filesystem (mount remount unmount getattr relabelfrom relabelto)))
;; the file systems that stage 1 mounts are labelled by init (the tmpfs roots, devtmpfs)
(allow init_domain fs_type (filesystem (relabelfrom relabelto associate)))
(allow init_domain file_type (filesystem (associate)))

;; the one-way boolean: loading a policy, switching enforcing off and setting a boolean are
;; possible until init sets it, which it does right after the load (the setbool that sets it is
;; the last one allowed). The kernel knows nothing special about this boolean; the policy makes
;; it one-way by keeping every rule that could clear it inside the block.
(boolean secure_mode_policyload false)
(booleanif (not secure_mode_policyload)
    (true
        (allow init_domain security_t (security (load_policy setenforce setbool)))
        (allow init_domain self (capability2 (mac_admin)))))

;; the service scripts (runit's run, log/run, check, finish; the core-services; ctrlaltdel):
;; a shell with the common tools, the runit control files, the service state in /run
(call daemon_type (initrc_t initrc_exec_t))
(call exec_files (initrc_t shell_exec_t))
(call exec_files (initrc_t bin_t))
(call exec_files (initrc_t usr_t))
(call exec_files (initrc_t initrc_exec_t))
(allow initrc_t self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid net_admin net_raw sys_resource sys_nice sys_admin sys_tty_config)))
(allow initrc_t self (netlink_netfilter_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
(allow initrc_t self (netlink_route_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto nlmsg_read nlmsg_write)))
(call manage_files (initrc_t runit_var_run_t))
(call manage_files (initrc_t vh_run_t))
(call manage_files (initrc_t var_run_t))
(call manage_files (initrc_t var_log_t))
(call manage_files (initrc_t var_lib_t))
(call manage_files (initrc_t vh_state_t))
(call manage_files (initrc_t tmp_t))
(call manage_files (initrc_t utmp_t))
(call rw_files (initrc_t etc_runtime_t))
(call read_files (initrc_t vh_conf_t))
(call read_files (initrc_t nft_conf_t))
(call read_files (initrc_t var_t))
(allow initrc_t sysfs_t (file (write)))
(allow initrc_t sysctl_type (dir (search)))
(allow initrc_t sysctl_type (file (read getattr open)))
(allow initrc_t init_t (unix_stream_socket (connectto)))           ; sv -> vh-ctl -> the manager
(allow initrc_t vh_init_sock_t sock_w)
(allow initrc_t init_domain (process (signal signull)))              ; sv 1 vh-acpid; runit-init's SIGCONT
(allow initrc_t domain (process (signal signull sigkill getattr)))   ; sv control of services, pgrep
(allow initrc_t domain (dir (search getattr read)))
(allow initrc_t domain (file (read getattr open)))
(allow initrc_t tty_device_t chr_rw)
(allow initrc_t devpts_t (chr_file (read write getattr ioctl)))
(allow initrc_t device_t (dir (read)))
(allow initrc_t devlog_t (sock_file (create unlink getattr write setattr)))
(allow initrc_t kmsg_device_t (chr_file (read write open getattr)))
(allow initrc_t rfkill_device_t chr_rw)

;; shutdown control: runit-void's poweroff, reboot and halt (runit-init), and vh-ctl: a request
;; to PID 1 through /run/runit/stopit's mode and SIGCONT, or the manager's socket
(type initctl_t)
(type initctl_exec_t) (call executable (initctl_exec_t))   ; /usr/bin/runit-init, poweroff, reboot, halt, shutdown, vh-ctl
(call domain_type (initctl_t))
(roletype system_r initctl_t)
(roletype user_r initctl_t)
(roletype admin_r initctl_t)
(allow initctl_t self (capability (sys_boot kill sys_tty_config)))
(call rw_files (initctl_t runit_var_run_t))
(allow initctl_t init_domain (process (signal signull)))
(allow initctl_t init_t (unix_stream_socket (connectto)))
(allow initctl_t vh_init_sock_t sock_w)
(allow initctl_t vh_run_t (dir (search getattr)))
(allow initctl_t utmp_t (file (read write getattr open lock)))
(allow initctl_t wtmp_t (file (read write getattr open lock append)))
(allow initctl_t tty_device_t chr_rw)
(allow initctl_t devpts_t (chr_file (read write getattr ioctl)))
