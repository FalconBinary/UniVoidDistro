;; selinux/policy/50-vh.cil: this distribution's own programs: vh-acpid, the plan and kernel tools,
;; the root helper scripts, the scheduler's loader, the dead man's switch.

(type vh_sbin_exec_t) (call executable (vh_sbin_exec_t))        ; /usr/local/sbin/vh-* shell scripts: vh-power, vh-bluetooth, vh-suid-strip, vh-net, vh-usb, vh-keys, vh-audit
(type vh_libexec_exec_t) (call executable (vh_libexec_exec_t))  ; /usr/local/libexec/vh/* but the browser sandbox and vh-seccomp
(type vh_tools_exec_t) (call executable (vh_tools_exec_t))      ; vh-kconf, vh-plan, vh-limine-update, vh-uki-verify, vh-selabel
(type sched_exec_t) (call executable (sched_exec_t))            ; vh-sched

;; ---------------------------------------------------------------- vh-acpid: the lid, the power button, the idle watchdog
(type acpid_t)
(type acpid_exec_t) (call executable (acpid_exec_t))
(call daemon_type (acpid_t acpid_exec_t))
(allow acpid_t self (capability (sys_boot kill)))
(allow acpid_t input_device_t (chr_file (ioctl read getattr lock open)))
(allow acpid_t self (netlink_kobject_uevent_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
(call read_files (acpid_t vh_conf_t))
(call manage_files (acpid_t vh_run_t))
(call rw_files (acpid_t runit_var_run_t))
(allow acpid_t sysfs_t (file (read getattr open)))
(allow acpid_t sysfs_t (lnk_file (read)))
(allow acpid_t init_domain (process (signal signull)))
(allow acpid_t init_t (unix_stream_socket (connectto)))
(allow acpid_t vh_init_sock_t sock_w)
(allow acpid_t userdomain (process (signal signull)))       ; the lock request to the session
(allow acpid_t user_runtime_t (dir (search getattr)))
(allow acpid_t user_runtime_t sock_w)
(allow acpid_t wm_t (unix_stream_socket (connectto)))
(call exec_files (acpid_t initctl_exec_t))
(call domtrans (acpid_t initctl_exec_t initctl_t))
(call exec_files (acpid_t bin_t))

;; ---------------------------------------------------------------- the plan, the kernel and the boot: vh-kconf, vh-plan, vh-limine-update, vh-selabel
(type vh_tools_t)
(call daemon_type (vh_tools_t vh_tools_exec_t))
(roletype admin_r vh_tools_t)
(allow vh_tools_t self (capability (sys_admin linux_immutable dac_override dac_read_search fowner chown fsetid sys_resource)))
(allow vh_tools_t self (capability2 (syslog)))
(allow vh_tools_t kernel_t (system (syslog_read)))
(allow vh_tools_t kmsg_device_t (chr_file (read getattr open)))
(typeattributeset mount_domain vh_tools_t)                    ; the ESP (noauto) for a UKI
(allow vh_tools_t efi_t (filesystem (mount unmount getattr)))
(allow vh_tools_t boot_t (dir (mounton)))
(call manage_files (vh_tools_t efi_t))
(call manage_files (vh_tools_t boot_t))
(call manage_files (vh_tools_t vh_conf_t))
(call manage_files (vh_tools_t vh_state_t))
(call manage_files (vh_tools_t vh_run_t))
(call manage_files (vh_tools_t vh_log_t))
(call read_files (vh_tools_t modules_object_t))
(call read_files (vh_tools_t firmware_t))
(call read_files (vh_tools_t xbps_db_t))
(call read_files (vh_tools_t sbctl_keys_t))          ; vh-limine-update signs the UKI with them
(call read_files (vh_tools_t var_log_t))
(call read_files (vh_tools_t etc_runtime_t))
(allow vh_tools_t efivarfs_t (dir (search read getattr write add_name remove_name)))
(allow vh_tools_t efivarfs_t (file (read write getattr setattr create unlink open)))
(allow vh_tools_t sysfs_t (lnk_file (read getattr)))
(allow vh_tools_t sysctl_type (dir (search read)))
(allow vh_tools_t sysctl_type (file (read getattr open)))
(allow vh_tools_t fixed_disk_device_t (blk_file (getattr ioctl read open)))
(allow vh_tools_t removable_device_t (blk_file (getattr ioctl read open)))
(allow vh_tools_t device_node (chr_file (getattr)))
(allow vh_tools_t device_node (blk_file (getattr)))
(allow vh_tools_t console_device_t (chr_file (read write getattr ioctl open)))
(allow vh_tools_t tty_device_t (chr_file (read write getattr ioctl open)))
(allow vh_tools_t devpts_t (chr_file (read write getattr ioctl)))
;; vh-selabel: the labels of the system's files (can_relabel), run by the installer, by vh-update
;; (pkg_t) and by hand (sysadm_t); it must see and set the label of everything
(typeattributeset can_relabel vh_tools_t)
(allow vh_tools_t file_type (dir (search read getattr open relabelfrom relabelto)))
(allow vh_tools_t device_t (filesystem (getattr)))                       ; statfs of /dev (devtmpfs)
(allow vh_tools_t device_t (chr_file (read write getattr ioctl)))        ; the console before its label at the early step
(call read_files (vh_tools_t vh_repo_t))                                 ; vh-kconf check reads kernel/profiles of the repository copy
(allow vh_tools_t tmp_t (file (write append getattr)))                   ; output redirected by the admin
(allow vh_tools_t file_type (file (getattr relabelfrom relabelto)))
(allow vh_tools_t file_type (lnk_file (getattr read relabelfrom relabelto)))
(allow vh_tools_t file_type (sock_file (getattr relabelfrom relabelto)))
(allow vh_tools_t file_type (fifo_file (getattr relabelfrom relabelto)))
(allow vh_tools_t file_type (chr_file (getattr relabelfrom relabelto)))
(allow vh_tools_t file_type (blk_file (getattr relabelfrom relabelto)))
(allow vh_tools_t fs_type (filesystem (getattr relabelfrom relabelto associate)))
(allow vh_tools_t fs_t (filesystem (getattr relabelfrom relabelto)))
(call exec_files (vh_tools_t bin_t))                  ; sbctl, dracut (through the hooks), efibootmgr
(call exec_files (vh_tools_t shell_exec_t))
(call exec_files (vh_tools_t vh_tools_exec_t))
(call exec_files (vh_tools_t pkg_exec_t))
(allow vh_tools_t sysadm_t (fd (use)))
(allow vh_tools_t sysadm_t (fifo_file (read write getattr)))
(allow vh_tools_t sysadm_t (process (sigchld)))
(allow vh_tools_t pkg_t (fd (use)))
(allow vh_tools_t pkg_t (fifo_file (read write getattr)))
(allow vh_tools_t pkg_t (process (sigchld)))
(allow vh_tools_t doas_t (fd (use)))
(allow vh_tools_t doas_t (fifo_file (read write getattr)))
(allow vh_tools_t doas_t (process (sigchld)))
(allow vh_tools_t initrc_t (fd (use)))
(allow vh_tools_t domain (dir (search getattr)))
(allow vh_tools_t domain (file (read getattr open)))

;; ---------------------------------------------------------------- the root helper scripts
(type vh_sbin_t)
(call daemon_type (vh_sbin_t vh_sbin_exec_t))
(call read_files (vh_sbin_t vh_repo_t))                                  ; vh-audit reads vh.conf of the repository copy
(roletype user_r vh_sbin_t)
(roletype admin_r vh_sbin_t)
(allow vh_sbin_t self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid net_admin net_raw sys_admin sys_resource sys_nice sys_tty_config)))
(allow vh_sbin_t self (netlink_netfilter_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
(allow vh_sbin_t self (netlink_route_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto nlmsg_read nlmsg_write)))
(call read_files (vh_sbin_t vh_conf_t))
(call read_files (vh_sbin_t nft_conf_t))
(call manage_files (vh_sbin_t vh_run_t))
(call manage_files (vh_sbin_t vh_state_t))
(call manage_files (vh_sbin_t runit_var_run_t))
(call manage_files (vh_sbin_t var_run_t))
(call rw_files (vh_sbin_t etc_runtime_t))
(allow vh_sbin_t sysfs_t (file (write)))
(allow vh_sbin_t sysctl_type (dir (search)))
(allow vh_sbin_t sysctl_type (file (read getattr open)))
(allow vh_sbin_t rfkill_device_t chr_rw)
(allow vh_sbin_t usb_device_t chr_rw)
(allow vh_sbin_t device_node (chr_file (getattr setattr)))
(allow vh_sbin_t device_node (blk_file (getattr setattr)))
(allow vh_sbin_t exec_type (file (setattr getattr)))        ; vh-suid-strip: the mode and the capability attribute
(allow vh_sbin_t bin_t (file (setattr)))
(allow vh_sbin_t init_t (unix_stream_socket (connectto)))
(allow vh_sbin_t vh_init_sock_t sock_w)
(allow vh_sbin_t initrc_t (unix_stream_socket (connectto)))
(allow vh_sbin_t domain (dir (search getattr read)))
(allow vh_sbin_t domain (file (read getattr open)))
(allow vh_sbin_t domain (process (signal signull getattr)))
(call exec_files (vh_sbin_t bin_t))
(call exec_files (vh_sbin_t shell_exec_t))
(call exec_files (vh_sbin_t vh_sbin_exec_t))
(call exec_files (vh_sbin_t vh_libexec_exec_t))
(call exec_files (vh_sbin_t initctl_exec_t))
(call exec_files (vh_sbin_t initrc_exec_t))
(allow vh_sbin_t doas_t (fd (use)))
(allow vh_sbin_t doas_t (fifo_file (read write getattr)))
(allow vh_sbin_t doas_t (process (sigchld)))
(allow vh_sbin_t udev_t (fd (use)))
(allow vh_sbin_t udev_t (process (sigchld)))
(allow vh_sbin_t devpts_t (chr_file (read write getattr ioctl)))
(allow vh_sbin_t tty_device_t (chr_file (read write getattr ioctl)))
(allow vh_sbin_t console_device_t (chr_file (read write getattr ioctl)))
(call dbus_client (vh_sbin_t))

;; ---------------------------------------------------------------- vh-sched: the sched_ext loader, the only BPF user
(type sched_t)
(call daemon_type (sched_t sched_exec_t))
(roletype admin_r sched_t)
(allow sched_t self (capability (sys_admin sys_nice sys_resource ipc_lock)))
(allow sched_t self (capability2 (bpf perfmon)))
(allow sched_t self (bpf (map_create map_read map_write prog_load prog_run)))
(allow sched_t self (process (setsched)))
(call read_files (sched_t sched_object_t))
(call read_files (sched_t vh_conf_t))
(call manage_files (sched_t bpf_t))
(allow sched_t sysfs_t (lnk_file (read getattr)))
(allow sched_t sysctl_kernel_t (file (write)))                ; the tests' sysrq; the service never writes
(allow sched_t proc_t (file (write)))
(allow sched_t sysadm_t (fd (use)))
(allow sched_t sysadm_t (fifo_file (read write getattr)))
(allow sched_t sysadm_t (process (sigchld)))
(allow sched_t tty_device_t (chr_file (read write getattr ioctl)))
(allow sched_t devpts_t (chr_file (read write getattr ioctl)))

;; ---------------------------------------------------------------- vh-deadman: the dead man's switch
(type deadman_t)
(type deadman_exec_t) (call executable (deadman_exec_t))
(call daemon_type (deadman_t deadman_exec_t))
(allow deadman_t self (capability (sys_admin sys_boot sys_rawio kill ipc_lock)))
(allow deadman_t self (netlink_kobject_uevent_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
(allow deadman_t watchdog_device_t chr_rw)
(allow deadman_t input_device_t (chr_file (ioctl read getattr lock open)))
(allow deadman_t mapper_device_t (blk_file (ioctl read write getattr open)))
(allow deadman_t zram_device_t (blk_file (ioctl read write getattr open)))
(allow deadman_t device_node (chr_file (getattr)))
(allow deadman_t device_t (chr_file (ioctl read write getattr open)))       ; /dev/mapper/control
(allow deadman_t sysfs_t (lnk_file (read getattr)))
(allow deadman_t sysfs_t (file (write)))
(allow deadman_t efivarfs_t (dir (search read getattr write add_name)))
(allow deadman_t efivarfs_t (file (read write getattr setattr create open)))
(allow deadman_t proc_t (file (write)))                                  ; /proc/sysrq-trigger
(allow deadman_t sysctl_vm_t (file (write)))                              ; drop_caches
(call read_files (deadman_t vh_conf_t))
(call manage_files (deadman_t vh_run_t))
(call rw_files (deadman_t runit_var_run_t))
(allow deadman_t init_domain (process (signal signull)))
(allow deadman_t init_t (unix_stream_socket (connectto)))
(allow deadman_t vh_init_sock_t sock_w)
(allow deadman_t fs_type (filesystem (unmount remount getattr)))
(allow deadman_t fs_t (filesystem (unmount remount getattr)))
(call exec_files (deadman_t bin_t))
