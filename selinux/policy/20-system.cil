;; ---------------------------------------------------------------- the password helper (unix_chkpwd, for the screen lock)
(type chkpwd_t)
(type chkpwd_exec_t) (call executable (chkpwd_exec_t))
(call domain_type (chkpwd_t))
(roletype user_r chkpwd_t)
(roletype admin_r chkpwd_t)
(roletype game_r chkpwd_t)
(allow chkpwd_t self (capability (setuid setgid dac_override audit_write)))
(allow chkpwd_t self (netlink_audit_socket (create getattr setattr read write nlmsg_relay)))
(allow chkpwd_t shadow_t file_r)
(allow chkpwd_t userdomain (fd (use)))
(allow chkpwd_t userdomain (process (sigchld)))
(allow chkpwd_t userdomain (fifo_file (read write getattr)))
(allow chkpwd_t userdomain (unix_stream_socket (read write getattr)))
(allow chkpwd_t devpts_t (chr_file (read write getattr ioctl)))
(allow chkpwd_t tty_device_t (chr_file (read write getattr ioctl)))

;; ---------------------------------------------------------------- file-system tools (fstrim, fsck, xfs_*)
(type fsadm_t)
(type fsadm_exec_t) (call executable (fsadm_exec_t))
(call daemon_type (fsadm_t fsadm_exec_t))
(roletype admin_r fsadm_t)
(allow fsadm_t self (capability (sys_admin sys_rawio ipc_lock sys_nice sys_resource)))
(allow fsadm_t fixed_disk_device_t (blk_file (ioctl read write getattr lock open)))
(allow fsadm_t mapper_device_t (blk_file (ioctl read write getattr lock open)))
(allow fsadm_t zram_device_t (blk_file (ioctl read write getattr lock open)))
(allow fsadm_t fs_t (filesystem (getattr quotamod quotaget)))
(allow fsadm_t file_type (dir (ioctl read getattr open search)))     ; fstrim: FITRIM on the mount point
(allow fsadm_t root_t (dir (ioctl read getattr open search)))
(call read_files (fsadm_t etc_runtime_t))
(call manage_files (fsadm_t vh_state_t))
(call manage_files (fsadm_t vh_log_t))
(allow fsadm_t sysfs_t (file (read getattr open)))
(call exec_files (fsadm_t fsadm_exec_t))
(call exec_files (fsadm_t bin_t))                 ; ionice -> fstrim
