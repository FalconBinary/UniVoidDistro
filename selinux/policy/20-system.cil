;; selinux/policy/20-system.cil: the system's services and the privileged paths: udev, dbus,
;; the system log, getty and login, doas and the admin's domain, the package manager, the
;; password helper, the file-system tools.

;; ---------------------------------------------------------------- udev
(type udev_t)
(type udev_exec_t) (call executable (udev_exec_t))       ; udevd, udevadm
(call daemon_type (udev_t udev_exec_t))
(allow udev_t self (capability (chown dac_override dac_read_search fowner fsetid mknod net_admin setgid setuid sys_admin sys_module sys_nice sys_resource sys_rawio)))
(allow udev_t self (netlink_kobject_uevent_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto name_bind)))
(allow udev_t self (netlink_route_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto nlmsg_read nlmsg_write)))
(allow udev_t self (unix_dgram_socket (sendto)))
(allow udev_t self (system (module_request)))
(allow udev_t kernel_t (system (module_request)))
(allow udev_t modules_object_t (system (module_load)))
(call read_files (udev_t modules_object_t))
(call read_files (udev_t udev_rules_t))
(call manage_files (udev_t udev_var_run_t))
(call manage_files (udev_t device_t))
(allow udev_t device_node (chr_file (ioctl read write create getattr setattr lock append open unlink link rename relabelfrom relabelto)))
(allow udev_t device_node (blk_file (ioctl read write create getattr setattr lock append open unlink link rename relabelfrom relabelto)))
(allow udev_t device_node dir_manage)            ; /dev/snd, /dev/dri, /dev/input: the directories of the nodes it makes
(allow udev_t device_node (lnk_file (create read getattr setattr unlink rename write)))   ; /dev/dri/by-path, /dev/char/MAJ:MIN
(allow udev_t device_node (blk_file (watch)))    ; inotify on the block devices (a changed partition table)
(allow udev_t self (file (write)))              ; its own oom_score_adj
(allow udev_t udev_rules_t (dir (watch)))        ; inotify on the rules directories
(allow udev_t udev_var_run_t (dir (watch)))
(allow udev_t lib_t (dir (watch)))
(allow udev_t sysfs_t (dir (ioctl read write getattr setattr lock open search add_name remove_name)))
(allow udev_t sysfs_t (file (ioctl read write getattr setattr lock append open)))
(allow udev_t sysfs_t (lnk_file (read getattr)))
(allow udev_t sysctl_type (dir (search)))
(allow udev_t sysctl_type (file (read getattr open)))
(allow udev_t sysctl_kernel_t (file (write)))                  ; /proc/sys/kernel/hotplug is read; nothing written
(call exec_files (udev_t bin_t))                                ; chgrp, chmod, ethtool, modprobe
(call exec_files (udev_t shell_exec_t))                         ; RUN+="/usr/local/sbin/vh-power"
(call exec_files (udev_t vh_sbin_exec_t))
(call exec_files (udev_t vh_libexec_exec_t))                    ; vh-usb-udev
(call read_files (udev_t vh_conf_t))
(call manage_files (udev_t vh_run_t))
(call rw_files (udev_t var_run_t))
(allow udev_t domain (dir (search getattr)))
(allow udev_t domain (file (read getattr open)))
(allow udev_t initrc_t (unix_stream_socket (connectto)))
(allow udev_t init_t (unix_stream_socket (connectto)))          ; vh-power may ask vh-ctl
(allow udev_t vh_init_sock_t sock_w)
(allow udev_t devpts_t (dir (search)))
;; stage 1 keeps udevd's socket and database for the service that takes over
(typetransition udev_t var_run_t dir "udev" udev_var_run_t)
(typetransition init_domain var_run_t dir "udev" udev_var_run_t)

;; ---------------------------------------------------------------- D-Bus (the system bus)
(type dbusd_t)
(type dbusd_exec_t) (call executable (dbusd_exec_t))
(call daemon_type (dbusd_t dbusd_exec_t))
(allow dbusd_t self (capability (setgid setuid sys_resource audit_write dac_override)))
(allow dbusd_t self (netlink_audit_socket (create getattr setattr read write nlmsg_relay)))
(call manage_files (dbusd_t dbus_var_run_t))
(typetransition dbusd_t var_run_t dir "dbus" dbus_var_run_t)
(typetransition init_domain var_run_t dir "dbus" dbus_var_run_t)
(typetransition initrc_t var_run_t dir "dbus" dbus_var_run_t)
(call manage_files (initrc_t dbus_var_run_t))    ; /etc/sv/dbus/run: install -d /run/dbus
(allow dbusd_t var_lib_t (dir (search getattr)))
(allow dbusd_t domain (dir (search getattr)))
(allow dbusd_t domain (file (read getattr open)))
(allow dbusd_t domain (process (getattr)))
(allow dbusd_t self (unix_stream_socket (connectto)))
;; a client of the system bus
(macro dbus_client ((type d))
    (allow d dbusd_t (unix_stream_socket (connectto)))
    (allow d dbus_var_run_t (dir (search getattr)))
    (allow d dbus_var_run_t sock_w)
    (allow dbusd_t d (fd (use)))
    (allow dbusd_t d (unix_stream_socket (read write getattr)))
    (allow dbusd_t d (process (getattr)))
    (allow dbusd_t d (dir (search getattr)))
    (allow dbusd_t d (file (read getattr open))))

;; ---------------------------------------------------------------- the system log (socklog, nanoklogd, vlogger)
(type syslogd_t)
(type syslogd_exec_t) (call executable (syslogd_exec_t))     ; socklog, nanoklogd, svlogd, vlogger, chpst
(call daemon_type (syslogd_t syslogd_exec_t))
(allow syslogd_t self (capability (chown dac_override dac_read_search fowner fsetid setgid setuid sys_resource sys_nice)))
(allow syslogd_t self (capability2 (syslog)))
(allow syslogd_t kernel_t (system (syslog_read syslog_mod)))
(allow syslogd_t proc_kmsg_t (file (read getattr open)))
(allow syslogd_t kmsg_device_t (chr_file (read getattr open)))
(call manage_files (syslogd_t var_log_t))
(call manage_files (syslogd_t devlog_t))
(typetransition syslogd_t device_t sock_file devlog_t)
(allow devlog_t device_t (filesystem (associate)))      ; /dev/log lives on devtmpfs
(allow syslogd_t device_t (dir (write add_name remove_name)))
(call exec_files (syslogd_t syslogd_exec_t))
(call exec_files (syslogd_t shell_exec_t))
(call exec_files (syslogd_t bin_t))

;; ---------------------------------------------------------------- the console: agetty and login
(type getty_t)
(type getty_exec_t) (call executable (getty_exec_t))
(call daemon_type (getty_t getty_exec_t))
(allow getty_t self (capability (chown dac_override fowner fsetid setgid setuid sys_admin sys_tty_config)))
(allow getty_t tty_device_t (chr_file (ioctl read write getattr setattr lock append open)))
(allow getty_t console_device_t (chr_file (ioctl read write getattr setattr lock append open)))
(call rw_files (getty_t utmp_t))
(allow getty_t var_log_t (dir (search)))         ; /var/log/wtmp: the login record
(allow getty_t var_run_t (dir (write add_name remove_name)))   ; /run/agetty.reload
(allow getty_t var_run_t (file (create read write getattr open unlink watch)))
(call rw_files (getty_t wtmp_t))
(dontaudit getty_t self (capability2 (checkpoint_restore)))   ; asked for on the way, not needed
(call read_files (getty_t etc_runtime_t))
(call domtrans (getty_t login_exec_t login_t))

(type login_t)
(type login_exec_t) (call executable (login_exec_t))
(call domain_type (login_t))
(roletype system_r login_t)
(typeattributeset can_change_role login_t)
(allow login_t self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap sys_resource sys_tty_config sys_admin audit_write audit_control)))
(allow login_t self (process (setexec setrlimit)))
(allow login_t self (netlink_audit_socket (create getattr setattr read write nlmsg_relay)))
(allow login_t getty_t (fd (use)))
(allow login_t getty_t (process (sigchld)))
(allow login_t shadow_t file_r)
(allow login_t shadow_t (dir (search)))
(call manage_files (login_t faillock_t))
(typetransition login_t var_run_t dir "faillock" faillock_t)
(typetransition init_domain var_run_t dir "faillock" faillock_t)
(call rw_files (login_t utmp_t))
(allow login_t self (file (write)))              ; /proc/self/loginuid (pam_loginuid)
(call rw_files (login_t wtmp_t))
(call rw_files (login_t var_log_t))              ; lastlog, btmp
(allow login_t tty_device_t (chr_file (ioctl read write getattr setattr lock append open relabelfrom relabelto)))
(allow login_t console_device_t (chr_file (ioctl read write getattr setattr lock append open)))
(allow login_t proc_t (file (write)))            ; /proc/self/loginuid (pam_loginuid)
(allow login_t home_root_t (dir (search getattr)))
(allow login_t home_type (dir (search getattr)))
(allow login_t home_type (file (getattr)))
;; pam_dumb_runtime_dir: /run/user and /run/user/UID
(call manage_files (login_t user_runtime_t))
(call manage_files (login_t var_run_t))
(typetransition login_t var_run_t dir "user" user_runtime_t)
(typetransition init_domain var_run_t dir "user" user_runtime_t)
(call manage_files (login_t pam_var_run_t))
;; the person's shell: the login shell of the account picks the domain and the role
(type user_shell_exec_t) (call executable (user_shell_exec_t))      ; /usr/local/bin/vh-usersh
(type admin_shell_exec_t) (call executable (admin_shell_exec_t))    ; /usr/local/bin/vh-adminsh
(type game_enter_exec_t) (call executable (game_enter_exec_t))      ; /usr/local/bin/vh-game-enter
;; libxcrypt's yescrypt tries mmap(MAP_HUGETLB) for its memory before falling back to ordinary
;; pages (an "anon_hugepage" file of hugetlbfs_t): refused silently in the domains that check
;; a password, the fallback is the path every machine without reserved huge pages takes anyway
(dontaudit login_t hugetlbfs_t (file (read map)))
(dontaudit doas_t hugetlbfs_t (file (read map)))
(dontaudit chkpwd_t hugetlbfs_t (file (read map)))
(call domtrans (login_t user_shell_exec_t user_t))
(call domtrans (login_t admin_shell_exec_t admin_t))
(call domtrans (login_t game_enter_exec_t game_t))
(roletransition system_r user_shell_exec_t process user_r)
(roletransition system_r admin_shell_exec_t process admin_r)
(roletransition system_r game_enter_exec_t process game_r)
(allow login_t userdomain (process (transition siginh rlimitinh noatsecure signal)))
(allow userdomain login_t (fd (use)))
(allow userdomain login_t (process (sigchld)))
(allow userdomain login_t (fifo_file (read write getattr)))
;; a shell that is not one of ours (an account made by hand) gets nothing: no transition rule

;; ---------------------------------------------------------------- doas
(type doas_t)
(type doas_exec_t) (call executable (doas_exec_t))
(call domain_type (doas_t))
(roletype user_r doas_t)
(roletype admin_r doas_t)
(roletype game_r doas_t)
(allow doas_t self (capability (setuid setgid setpcap sys_resource audit_write chown dac_override dac_read_search fowner)))
(allow doas_t self (process (setexec setrlimit setsched)))
(allow doas_t self (netlink_audit_socket (create getattr setattr read write nlmsg_relay)))
(call read_files (doas_t doas_conf_t))
(allow doas_t shadow_t file_r)
(call manage_files (doas_t faillock_t))
(allow doas_t var_run_t (dir (search getattr)))
(allow doas_t tty_device_t chr_rw)
(allow doas_t devpts_t (chr_file (ioctl read write getattr lock append open)))
(allow doas_t home_type (dir (search getattr)))
(allow doas_t user_runtime_t (dir (search getattr)))
(allow doas_t userdomain (fd (use)))
(allow doas_t userdomain (process (sigchld signal)))
(allow doas_t userdomain (fifo_file (read write getattr)))
(allow doas_t userdomain (unix_stream_socket (read write getattr)))
(allow doas_t userdomain (dir (search getattr)))
(allow doas_t userdomain (file (read getattr open)))
(allow userdomain doas_t (process (signal sigkill)))
(call domtrans (userdomain doas_exec_t doas_t))
;; what doas runs. For the everyday user: the narrow commands of doas.conf, each its own domain,
;; none of them the admin's. For the admin: sysadm_t, the confined administration domain. The
;; roles decide: sysadm_t is not in user_r, so even a wrong doas.conf gives the user no admin
;; domain; the transition is refused by the policy.
(call domtrans (doas_t vh_browser_exec_t vh_browser_t))
(call domtrans (doas_t initctl_exec_t initctl_t))
(call domtrans (doas_t vh_sbin_exec_t vh_sbin_t))
(call domtrans (doas_t shell_exec_t sysadm_t))
(call domtrans (doas_t admin_shell_exec_t sysadm_t))   ; doas -s runs the admin's login shell, vh-adminsh
(call domtrans (doas_t bin_t sysadm_t))
(call domtrans (doas_t vh_tools_exec_t vh_tools_t))
(call domtrans (doas_t pkg_exec_t pkg_t))
(call domtrans (doas_t fsadm_exec_t fsadm_t))
(allow doas_t sysadm_t (process (transition siginh rlimitinh noatsecure)))

;; ---------------------------------------------------------------- the admin's domain
;; what the admin does as root: the system's files, the services, the firewall, the kernel's
;; knobs, the logs, the Secure Boot keys. Not: the everyday user's files, loading a module,
;; raw I/O, ptrace, writing a program file (the package manager does that), the policy.
(type sysadm_t)
(call domain_type (sysadm_t))
(roletype admin_r sysadm_t)
(allow sysadm_t self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap linux_immutable net_bind_service net_broadcast net_admin net_raw ipc_lock ipc_owner sys_chroot sys_admin sys_boot sys_nice sys_resource sys_time sys_tty_config mknod lease audit_write audit_control setfcap)))
(allow sysadm_t self (capability2 (syslog wake_alarm block_suspend audit_read)))
(allow sysadm_t self (process (setexec setfscreate setrlimit setsched)))
(allow sysadm_t self (netlink_route_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto name_bind nlmsg_read nlmsg_write)))
(allow sysadm_t self (netlink_netfilter_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto name_bind)))
(allow sysadm_t self (netlink_kobject_uevent_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto name_bind)))
(allow sysadm_t self (netlink_generic_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto name_bind)))
(allow sysadm_t self (packet_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
(allow sysadm_t self (icmp_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown recvfrom sendto)))
(allow sysadm_t kernel_t (system (syslog_read syslog_mod syslog_console)))
(call net_client (sysadm_t))
(allow sysadm_t port_type (tcp_socket (name_connect)))
(typeattributeset mount_domain sysadm_t)
(typeattributeset can_relabel sysadm_t)
(allow sysadm_t fs_type (filesystem (mount remount unmount getattr quotamod quotaget)))
(allow sysadm_t fs_t (filesystem (mount remount unmount getattr quotamod quotaget)))
(allow sysadm_t file_type (dir (mounton)))
(call manage_files (sysadm_t root_t))
(call manage_files (sysadm_t etc_t))
(call manage_files (sysadm_t etc_runtime_t))
(call manage_files (sysadm_t passwd_file_t))
(call manage_files (sysadm_t shadow_t))
(call manage_files (sysadm_t doas_conf_t))
(call manage_files (sysadm_t var_t))
(call manage_files (sysadm_t var_lib_t))
(call manage_files (sysadm_t var_log_t))
(call manage_files (sysadm_t wtmp_t))
(call manage_files (sysadm_t var_run_t))
(call manage_files (sysadm_t var_cache_t))
(call manage_files (sysadm_t var_tmp_t))
(call manage_files (sysadm_t tmp_t))
(call manage_files (sysadm_t utmp_t))
(call manage_files (sysadm_t vh_repo_t))
;; the admin looks at every process (ps, pgrep: /proc/PID of any domain), never into it (no ptrace,
;; neverallow #2; the capability a shell asks for while reading another uid's /proc/PID/exe is refused quietly)
(allow sysadm_t domain (dir (search getattr read open)))
(allow sysadm_t domain (file (read getattr open)))
(allow sysadm_t domain (lnk_file (read)))
(dontaudit sysadm_t self (capability (sys_ptrace)))
(allow sysadm_t home_root_t (dir (read getattr open search)))
(call manage_files (sysadm_t runit_var_run_t))
(call manage_files (sysadm_t vh_run_t))
(call manage_files (sysadm_t vh_state_t))
(call manage_files (sysadm_t vh_log_t))
(call manage_files (sysadm_t vh_conf_t))
(call manage_files (sysadm_t nft_conf_t))
(call manage_files (sysadm_t resolv_conf_t))
(call manage_files (sysadm_t unbound_conf_t))
(call manage_files (sysadm_t unbound_var_t))
(call manage_files (sysadm_t chrony_var_lib_t))
(call manage_files (sysadm_t iwd_conf_t))
(call manage_files (sysadm_t dhcpcd_var_lib_t))
(call manage_files (sysadm_t udev_rules_t))
(call manage_files (sysadm_t boot_t))
(call manage_files (sysadm_t efi_t))
(call manage_files (sysadm_t sbctl_keys_t))
(call manage_files (sysadm_t admin_home_t))
(call manage_files (sysadm_t xbps_db_t))
(call manage_files (sysadm_t xbps_cache_t))
(call manage_files (sysadm_t game_root_t))
(call manage_files (sysadm_t kbuild_root_t))
(call manage_files (sysadm_t faillock_t))
(call read_files (sysadm_t modules_object_t))
(call read_files (sysadm_t firmware_t))
(call read_files (sysadm_t browser_home_t))
(call read_files (sysadm_t xfer_t))
(call read_files (sysadm_t vh_sandbox_run_t))
(call read_files (sysadm_t user_runtime_t))
(allow sysadm_t home_type (dir (getattr search)))
(call exec_files (sysadm_t bin_t))
(call exec_files (sysadm_t shell_exec_t))
(call exec_files (sysadm_t usr_t))
(call exec_files (sysadm_t initrc_exec_t))
(call exec_files (sysadm_t initctl_exec_t))
(call exec_files (sysadm_t vh_sbin_exec_t))
(call exec_files (sysadm_t vh_libexec_exec_t))
(call exec_files (sysadm_t init_exec_t))          ; vh-init --install, vh-stage1 --status
(call exec_files (sysadm_t udev_exec_t))          ; udevadm
(allow sysadm_t exec_type file_r)
(allow sysadm_t file_type (file (relabelfrom relabelto)))
(allow sysadm_t file_type (dir (relabelfrom relabelto)))
(allow sysadm_t file_type (lnk_file (relabelfrom relabelto)))
(allow sysadm_t file_type (sock_file (relabelfrom relabelto)))
(allow sysadm_t file_type (fifo_file (relabelfrom relabelto)))
(allow sysadm_t device_node (chr_file (ioctl read write getattr setattr lock append open relabelfrom relabelto)))
(allow sysadm_t device_node (blk_file (ioctl read write getattr setattr lock append open relabelfrom relabelto)))
(call manage_files (sysadm_t device_t))
(allow sysadm_t devpts_t (chr_file (ioctl read write getattr setattr lock append open)))
(allow sysadm_t sysctl_type (dir (search read getattr)))
(allow sysadm_t sysctl_type (file (read write getattr setattr open)))
(allow sysadm_t sysfs_t (dir (ioctl read write getattr setattr lock open search add_name remove_name)))
(allow sysadm_t sysfs_t (file (ioctl read write getattr setattr lock append open)))
(allow sysadm_t sysfs_t (lnk_file (read getattr)))
(call manage_files (sysadm_t cgroup_t))
(allow sysadm_t bpf_t (dir (search read getattr)))
(allow sysadm_t efivarfs_t (dir (search read getattr write add_name remove_name)))
(allow sysadm_t efivarfs_t (file (read write getattr setattr create unlink open)))
(allow sysadm_t securityfs_t (dir (search read getattr)))
(allow sysadm_t securityfs_t (file (read getattr open)))
(allow sysadm_t security_t (dir (search read getattr)))
(allow sysadm_t security_t (file (read getattr open)))     ; the enforcing state, the booleans: read only
(allow sysadm_t proc_t (dir (search read getattr)))
(allow sysadm_t proc_t (file (read getattr open write)))
(allow sysadm_t proc_kmsg_t (file (read getattr open)))
(allow sysadm_t kmsg_device_t (chr_file (read write getattr open append)))
(allow sysadm_t domain (process (signal sigkill sigstop signull getsched setsched getattr getsession getpgid)))
(allow sysadm_t domain (dir (search read getattr)))
(allow sysadm_t domain (file (read getattr open)))
(allow sysadm_t domain (lnk_file (read getattr)))
(allow sysadm_t init_domain (process (signal signull)))
(allow sysadm_t init_t (unix_stream_socket (connectto)))
(allow sysadm_t vh_init_sock_t sock_w)
(allow sysadm_t initrc_t (unix_stream_socket (connectto)))
(call dbus_client (sysadm_t))
(allow sysadm_t tty_device_t chr_rw)
(allow sysadm_t console_device_t chr_rw)
(call domtrans (sysadm_t pkg_exec_t pkg_t))
(call domtrans (sysadm_t vh_tools_exec_t vh_tools_t))
(call domtrans (sysadm_t fsadm_exec_t fsadm_t))
(call domtrans (sysadm_t sched_exec_t sched_t))
(call domtrans (sysadm_t doas_exec_t doas_t))
(allow sysadm_t admin_t (fd (use)))
(allow sysadm_t admin_t (fifo_file (read write getattr)))
(allow sysadm_t admin_t (unix_stream_socket (read write getattr)))
(allow sysadm_t admin_t (process (sigchld signal)))
(allow sysadm_t doas_t (fd (use)))
(allow sysadm_t doas_t (fifo_file (read write getattr)))
(allow sysadm_t doas_t (unix_stream_socket (read write getattr)))

;; ---------------------------------------------------------------- the package manager and its hooks
;; thor (xbps), xbps-install/-remove/-reconfigure, the kernel hooks (dracut, sbctl, Limine),
;; vh-update: the one domain that writes program files. Reached from sysadm_t only.
(type pkg_t)
(type pkg_exec_t) (call executable (pkg_exec_t))     ; thor, xbps-*, vh-update, vh-pkg, vh-deep-clean, xbps-reconfigure
(call domain_type (pkg_t))
(roletype admin_r pkg_t)
(roletype system_r pkg_t)
(allow pkg_t self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap linux_immutable net_admin sys_chroot sys_admin sys_nice sys_resource sys_tty_config mknod setfcap)))
(allow pkg_t self (process (setexec setfscreate setrlimit)))
(call exec_files (pkg_t vh_repo_t))              ; vh-update runs the scripts of the repository copy
(typeattributeset mount_domain pkg_t)
(typeattributeset can_relabel pkg_t)
(allow pkg_t fs_type (filesystem (mount remount unmount getattr)))
(allow pkg_t fs_t (filesystem (mount remount unmount getattr)))
(allow pkg_t file_type (dir (mounton)))
(call net_client (pkg_t))
(allow pkg_t http_port_t (tcp_socket (name_connect)))
;; everything the packages own
(call manage_files (pkg_t root_t))
(call manage_files (pkg_t bin_t))
(call manage_files (pkg_t lib_t))
(call manage_files (pkg_t ld_so_t))
(call manage_files (pkg_t ld_so_cache_t))
(call manage_files (pkg_t usr_t))
(call manage_files (pkg_t etc_t))
(call manage_files (pkg_t etc_runtime_t))
(call manage_files (pkg_t passwd_file_t))
(call manage_files (pkg_t shadow_t))
(call manage_files (pkg_t doas_conf_t))
(call manage_files (pkg_t locale_t))
(call manage_files (pkg_t zoneinfo_t))
