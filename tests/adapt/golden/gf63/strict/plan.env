# vh-plan: the plan of gf63 for the shell installer (install/lib.sh). Every value comes
# from hwdb/ or is a number; plan-report.txt says which rule put it here.
VH_PLAN_ARCH='x86_64'
VH_PLAN_TIER='full'
VH_PLAN_SECURITY='strict'
VH_PLAN_CLASS='laptop'
VH_PLAN_TAGS='acpi backlight battery bluetooth camera dgpu disk disk-discard disk-nvme disk-on-nvme display displays-2 efi efi64 epp iommu iommu-active keyboard keyboard-i8042 laptop lid mains mor power-button secure-boot secure-boot-on smt sound tpm tpm2 wifi wired x86-64-v2 x86-64-v3'
VH_PLAN_MISSING=''
VH_PLAN_ACKNOWLEDGE=''
VH_PLAN_PACKAGES='bluez dhcpcd intel-media-driver intel-ucode iw iwd linux-firmware-intel linux-firmware-network tpm2-tools wireless-regdb'
VH_PLAN_KCONFIG='cpu-intel cpu-x86-aes gpu-i915 input-i8042 iommu-vtd pinctrl-intel-cnl storage-nvme tpm-crb'
VH_PLAN_FEATURES='bluetooth usb-common'
VH_PLAN_FIRMWARE='i915/cml_* i915/kbl_* intel-ucode/* intel/ibt-* iwlwifi-Qu* regulatory.db* rtl_nic/*'
VH_PLAN_CMDLINE='efi=disable_early_pci_dma ia32_emulation=0 intel_iommu=on'
VH_PLAN_SERVICES='dhcpcd-eth0 iwd vh-acpid vh-fstrim'
VH_PLAN_UDEV='99-vh-dgpu-off.rules'
VH_PLAN_DENY='kvm kvm_intel mei mei_hdcp mei_me mei_pxp mei_wdt nouveau rtsx_pci rtsx_pci_sdmmc uvcvideo'
VH_PLAN_DRACUT='atkbd i8042'
VH_PLAN_LUKS_CIPHER='aes-xts-plain64'
VH_PLAN_LUKS_KEY_SIZE='512'
VH_PLAN_LUKS_MEM_KIB='1048576'
VH_PLAN_LUKS_PARALLEL='4'
VH_PLAN_NR_CPUS='12'
VH_PLAN_MARCH='skylake'
VH_PLAN_RENDERER='gles2'
VH_PLAN_WATCHDOG='iTCO_wdt'
