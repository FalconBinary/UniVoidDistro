    .exports = .{},
    .notes = .{
        .{ .value = "ASUS: Advanced Mode, Boot, Secure Boot, Key Management, Clear Secure Boot Keys puts the firmware in Setup Mode for vh-firstboot.", .rules = .{"board.asus.secure-boot"} },
        .{ .value = "The board's sensors (Super I/O) are not probed: on most ASUS, MSI and ASRock boards it is a Nuvoton chip (nct6775) [VERIFY with sensors-detect from a live image].", .rules = .{"board.superio"} },
        .{ .value = "The AMD PSP driver (ccp) is kept: it also feeds the kernel's random number generator. Refusing it is a decision for VH_EXTRA_CMDLINE ([VERIFY] the fTPM without it).", .rules = .{"cpu.amd.psp"} },
        .{ .value = "Two CCDs with different L3 sizes: latency-sensitive work (games) runs best on the V-Cache CCD [VERIFY on this machine with bench/].", .rules = .{"cpu.amd.x3d"} },
        .{ .value = "Realtek Ethernet: EEE is off (rootfs/etc/udev/rules.d/99-vh-net.rules), the usual cause of link drops.", .rules = .{"quirk.r8169-eee"} },
    },
    .luks = .{
        .cipher = "aes-xts-plain64",
        .key_size = 512,
        .pbkdf_memory_kib = 1048576,
        .pbkdf_parallel = 4,
    },
