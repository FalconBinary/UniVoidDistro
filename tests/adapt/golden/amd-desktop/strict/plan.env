# vh-plan: the plan of amd-desktop for the shell installer (install/lib.sh). Every value comes
# from hwdb/ or is a number; plan-report.txt says which rule put it here.
VH_PLAN_ARCH='x86_64'
VH_PLAN_TIER='full'
VH_PLAN_SECURITY='strict'
VH_PLAN_CLASS='desktop'
VH_PLAN_TAGS='acpi bluetooth disk disk-ata disk-discard disk-nvme disk-on-ahci disk-on-nvme disk-on-sd_mod disk-rotational display displays-2 efi efi64 epp iommu iommu-active keyboard keyboard-usb mor multi-llc power-button secure-boot secure-boot-on smt sound tpm tpm2 wifi wired x86-64-v2 x86-64-v3 x86-64-v4'
VH_PLAN_MISSING=''
VH_PLAN_ACKNOWLEDGE=''
VH_PLAN_PACKAGES='bluez dhcpcd iw iwd linux-firmware-amd linux-firmware-network mesa-vaapi mesa-vulkan-radeon tpm2-tools wireless-regdb'
VH_PLAN_KCONFIG='acpi-tiny-power-button-off bt-mediatek cpu-amd cpu-amd-x3d cpu-x86-aes gpu-amdgpu hwmon-nct6775 iommu-amd pinctrl-amd storage-ahci storage-nvme tpm-crb'
VH_PLAN_FEATURES='bluetooth usb-common'
VH_PLAN_FIRMWARE='amd-ucode/* amdgpu/dcn_3_1_5_* amdgpu/dcn_3_2_1_* amdgpu/gc_10_3_6_* amdgpu/gc_11_0_2_* amdgpu/psp_13_0_5_* amdgpu/psp_13_0_7_* amdgpu/sdma_5_2_6* amdgpu/sdma_6_0_2* amdgpu/smu_13_0_7* amdgpu/vcn_3_1_2* amdgpu/vcn_4_0_4* mediatek/BT_RAM_CODE_MT79* mediatek/WIFI_MT7922_patch_mcu_1_1_hdr.bin* mediatek/WIFI_MT7961_patch_mcu_1_2_hdr.bin* mediatek/WIFI_MT7961_patch_mcu_1a_2_hdr.bin* mediatek/WIFI_RAM_CODE_MT7922_1.bin* mediatek/WIFI_RAM_CODE_MT7961_1.bin* mediatek/WIFI_RAM_CODE_MT7961_1a.bin* mediatek/mt7925/BT_RAM_CODE* regulatory.db* rtl_nic/*'
VH_PLAN_CMDLINE='efi=disable_early_pci_dma ia32_emulation=0'
VH_PLAN_SERVICES='dhcpcd-eth0 iwd vh-acpid vh-fstrim'
VH_PLAN_UDEV=''
VH_PLAN_UDEV_KNOWN='99-vh-dgpu-off.rules'
VH_PLAN_DENY='kvm kvm_amd rtsx_pci rtsx_pci_sdmmc tiny_power_button uvcvideo'
VH_PLAN_DRACUT='hid_generic usbcore usbhid xhci_pci'
VH_PLAN_INTERNAL_INPUT=''
VH_PLAN_LUKS_CIPHER='aes-xts-plain64'
VH_PLAN_LUKS_KEY_SIZE='512'
VH_PLAN_LUKS_MEM_KIB='1048576'
VH_PLAN_LUKS_PARALLEL='4'
VH_PLAN_NR_CPUS='32'
VH_PLAN_MARCH='znver4'
VH_PLAN_RENDERER='gles2'
VH_PLAN_WATCHDOG='sp5100_tco'
