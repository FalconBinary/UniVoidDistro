# vh-plan: the plan of rpi5 for the shell installer (install/lib.sh). Every value comes
# from hwdb/ or is a number; plan-report.txt says which rule put it here.
VH_PLAN_ARCH='aarch64'
VH_PLAN_TIER='reduced'
VH_PLAN_SECURITY='tiered'
VH_PLAN_CLASS='sbc'
VH_PLAN_TAGS='bluetooth devicetree disk disk-discard disk-mmc disk-on-mmc_block disk-on-sdhci_brcmstb display keyboard keyboard-usb sbc sound wifi wired'
VH_PLAN_MISSING='uefi secure-boot tpm2 iommu'
VH_PLAN_ACKNOWLEDGE='uefi secure-boot tpm2 iommu'
VH_PLAN_PACKAGES='bluez dhcpcd iw iwd linux-firmware-broadcom linux-firmware-network wireless-regdb'
VH_PLAN_KCONFIG='cpu-arm64 cpu-arm64-aes gpu-vc4 storage-mmc'
VH_PLAN_FEATURES='bluetooth usb-common'
VH_PLAN_FIRMWARE='brcm/brcmfmac* cypress/cyfmac* regulatory.db*'
VH_PLAN_CMDLINE=''
VH_PLAN_SERVICES='dhcpcd-eth0 iwd vh-fstrim'
VH_PLAN_UDEV=''
VH_PLAN_DENY='rtsx_pci rtsx_pci_sdmmc uvcvideo'
VH_PLAN_DRACUT='dwc3 hid_generic pcie_brcmstb rp1 usbcore usbhid xhci_plat_hcd'
VH_PLAN_LUKS_CIPHER='aes-xts-plain64'
VH_PLAN_LUKS_KEY_SIZE='512'
VH_PLAN_LUKS_MEM_KIB='1048576'
VH_PLAN_LUKS_PARALLEL='4'
VH_PLAN_NR_CPUS='4'
VH_PLAN_MARCH='cortex-a76'
VH_PLAN_RENDERER='gles2'
VH_PLAN_WATCHDOG='bcm2835_wdt'
