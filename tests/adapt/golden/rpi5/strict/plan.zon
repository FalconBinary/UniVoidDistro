.{
    .format = 1,
    .tool = "vh-plan",
    .machine = "rpi5",
    .arch = "aarch64",
    .tier = "reduced",
    .security = "strict",
    .tags = .{
        "bluetooth",
        "devicetree",
        "disk",
        "disk-discard",
        "disk-mmc",
        "disk-on-mmc_block",
        "disk-on-sdhci_brcmstb",
        "display",
        "keyboard",
        "keyboard-usb",
        "sbc",
        "sound",
        "wifi",
        "wired",
    },
    .missing = .{
        .{
            .id = "uefi",
            .why = "On ARM64 the verified boot chain of this system needs UEFI (servers, laptops); a Raspberry Pi boots from its own firmware.",
            .risk = "The board's firmware boots the kernel unverified: whoever holds the board for a while can replace it and read what is typed.",
            .fix = "A UEFI firmware for the board where one exists [VERIFY], or the Raspberry Pi's own secure boot (milestone U5: its key is burnt into OTP, irreversibly).",
            .floor = false,
        },
        .{
            .id = "secure-boot",
            .why = "Secure Boot with the system's own keys verifies the bootloader and the UKI before they run.",
            .risk = "The boot chain is not verified: an evil maid can replace the kernel and capture the LUKS passphrase.",
            .fix = "Enable Secure Boot support (Custom or Standard mode) in the firmware setup; the system enrols its own keys after the first boot (install/20-firstboot.sh).",
            .floor = false,
        },
        .{
            .id = "tpm2",
            .why = "A TPM 2.0 measures the boot (tpm2-totp shows that it is unchanged) and its event log lists the Option ROMs whose hashes the key enrolment must keep.",
            .risk = "No TPM 2.0: no tpm2-totp against an evil maid, no measured boot, and no Option ROM check before the Secure Boot keys are enrolled (the Microsoft certificates are then kept).",
            .fix = "Enable the firmware TPM (Intel PTT, AMD fTPM) or the TPM module in the firmware setup.",
            .floor = false,
        },
        .{
            .id = "iommu",
            .why = "An IOMMU confines every device's DMA to the memory the kernel gives it.",
            .risk = "No IOMMU: a malicious or compromised device (Thunderbolt, ExpressCard, a PCIe card) can read and write all memory by DMA.",
            .fix = "Enable VT-d (Intel) or AMD-Vi / IOMMU (AMD) in the firmware setup; a virtual machine needs an emulated IOMMU (QEMU: -device intel-iommu).",
            .floor = false,
        },
    },
    .acknowledge = .{},
    .scalars = .{
        .{
            .key = "class",
            .value = "sbc",
            .rule = "class.sbc.set",
        },
        .{
            .key = "march",
            .value = "cortex-a76",
            .rule = "arm.mcpu.cortex-a76",
        },
        .{
            .key = "renderer",
            .value = "gles2",
            .rule = "gpu.renderer.gles2",
        },
        .{
            .key = "watchdog",
            .value = "bcm2835_wdt",
            .rule = "arm.watchdog.bcm2835",
        },
    },
    .packages = .{
        .{ .value = "bluez", .rules = .{"bt.bluez"} },
        .{ .value = "dhcpcd", .rules = .{"net.wired.dhcp"} },
        .{ .value = "iw", .rules = .{"net.wifi"} },
        .{ .value = "iwd", .rules = .{"net.wifi"} },
        .{ .value = "linux-firmware-broadcom", .rules = .{"net.brcmfmac"} },
        .{ .value = "linux-firmware-network", .rules = .{"net.wifi"} },
        .{ .value = "wireless-regdb", .rules = .{"net.wifi"} },
    },
    .kconfig = .{
        .{ .value = "cpu-arm64", .rules = .{"arm.kernel"} },
        .{ .value = "cpu-arm64-aes", .rules = .{"arm.aes"} },
        .{ .value = "gpu-vc4", .rules = .{"gpu.vc4"} },
        .{ .value = "storage-mmc", .rules = .{"storage.mmc"} },
    },
    .features = .{
        .{ .value = "bluetooth", .rules = .{"bt.bluez"} },
        .{ .value = "usb-common", .rules = .{"usb.common"} },
        .{ .value = "wifi", .rules = .{"net.wifi"} },
    },
    .firmware = .{
        .{ .value = "brcm/brcmfmac*", .rules = .{"net.brcmfmac"} },
        .{ .value = "cypress/cyfmac*", .rules = .{"net.brcmfmac"} },
        .{ .value = "regulatory.db*", .rules = .{"net.wifi"} },
    },
    .cmdline = .{},
    .services = .{
        .{ .value = "dhcpcd-eth0", .rules = .{"net.wired.dhcp"} },
        .{ .value = "iwd", .rules = .{"net.wifi"} },
        .{ .value = "vh-fstrim", .rules = .{"storage.trim"} },
    },
    .udev = .{},
    .deny = .{
        .{ .value = "rtsx_pci", .rules = .{"cardreader.off"} },
        .{ .value = "rtsx_pci_sdmmc", .rules = .{"cardreader.off"} },
        .{ .value = "uvcvideo", .rules = .{"camera.off"} },
    },
    .dracut = .{
        .{ .value = "dwc3", .rules = .{"keyboard usb"} },
        .{ .value = "hid_generic", .rules = .{"keyboard usb"} },
        .{ .value = "pcie_brcmstb", .rules = .{"keyboard usb"} },
        .{ .value = "rp1", .rules = .{"keyboard usb"} },
        .{ .value = "usbcore", .rules = .{"keyboard usb"} },
        .{ .value = "usbhid", .rules = .{"keyboard usb"} },
        .{ .value = "xhci_plat_hcd", .rules = .{"keyboard usb"} },
    },
    .modules = .{
        .{ .value = "bcm2835_wdt", .rules = .{"device platform 107d200000.watchdog"} },
        .{ .value = "brcmfmac", .rules = .{"device sdio mmc1:0001:1"} },
        .{ .value = "dwc3", .rules = .{"device platform 1f00200000.usb"} },
        .{ .value = "hci_uart", .rules = .{"device serial serial0-0"} },
        .{ .value = "hid_generic", .rules = .{"device hid 0003:046D:C31C.0001"} },
        .{ .value = "macb", .rules = .{"device platform 1f00100000.ethernet"} },
        .{ .value = "mmc_block", .rules = .{"device mmc mmc0:aaaa"} },
        .{ .value = "pcie_brcmstb", .rules = .{"device platform 1000120000.pcie"} },
        .{ .value = "rp1", .rules = .{"device pci 0001:01:00.0"} },
        .{ .value = "rtc_rpi", .rules = .{"device platform 107d004000.rtc"} },
        .{ .value = "sdhci_brcmstb", .rules = .{ "device platform 1000fff000.mmc", "device platform 1001100000.mmc" } },
        .{ .value = "usbcore", .rules = .{ "device usb 1-1", "device usb usb1" } },
        .{ .value = "usbhid", .rules = .{"device usb 1-1:1.0"} },
        .{ .value = "v3d", .rules = .{"device platform 1002000000.v3d"} },
        .{ .value = "vc4", .rules = .{ "device platform 107c701400.hdmi", "device platform axi:gpu" } },
        .{ .value = "xhci_plat_hcd", .rules = .{"device platform xhci-hcd.0"} },
    },
    .internal_input = .{},
    .exports = .{},
    .notes = .{},
    .luks = .{
        .cipher = "aes-xts-plain64",
        .key_size = 512,
        .pbkdf_memory_kib = 1048576,
        .pbkdf_parallel = 4,
    },
    .kernel = .{ .nr_cpus = 4, .march = "cortex-a76" },
    .unknown = .{},
    .udev_known = .{"99-vh-dgpu-off.rules"},
}
