.{
    .format = 1,
    .tool = "vh-plan",
    .machine = "aarch64-virt",
    .arch = "aarch64",
    .tier = "reduced",
    .security = "tiered",
    .tags = .{
        "acpi",
        "disk",
        "disk-discard",
        "disk-on-virtio_pci",
        "disk-virtio",
        "efi",
        "efi64",
        "keyboard",
        "keyboard-usb",
        "power-button",
        "vm",
        "wired",
    },
    .missing = .{
        .{
            .id = "secure-boot",
            .why = "Secure Boot with the system's own keys verifies the bootloader and the UKI before they run.",
            .risk = "The boot chain is not verified: an evil maid can replace the kernel and capture the LUKS passphrase.",
            .fix = "Enable Secure Boot support (Custom or Standard mode) in the firmware setup; the system enrols its own keys after the first boot (install/20-firstboot.sh).",
            .floor = false,
        },
        .{
            .id = "tpm2",
            .why = "A TPM 2.0 measures the boot (tpm2-totp shows that it is unchanged) and its event log lists the Option ROMs whose hashes the key enrolment must keep.",
            .risk = "No TPM 2.0: no tpm2-totp against an evil maid, no measured boot, and no Option ROM check before the Secure Boot keys are enrolled (the Microsoft certificates are then kept).",
            .fix = "Enable the firmware TPM (Intel PTT, AMD fTPM) or the TPM module in the firmware setup.",
            .floor = false,
        },
        .{
            .id = "iommu",
            .why = "An IOMMU confines every device's DMA to the memory the kernel gives it.",
            .risk = "No IOMMU: a malicious or compromised device (Thunderbolt, ExpressCard, a PCIe card) can read and write all memory by DMA.",
            .fix = "Enable VT-d (Intel) or AMD-Vi / IOMMU (AMD) in the firmware setup; a virtual machine needs an emulated IOMMU (QEMU: -device intel-iommu).",
            .floor = false,
        },
    },
    .acknowledge = .{
        "secure-boot",
        "tpm2",
        "iommu",
    },
    .scalars = .{
        .{
            .key = "class",
            .value = "vm",
            .rule = "class.vm",
        },
        .{
            .key = "march",
            .value = "armv8-a",
            .rule = "arm.mcpu.generic",
        },
        .{
            .key = "renderer",
            .value = "pixman",
            .rule = "gpu.renderer.vm",
        },
        .{
            .key = "watchdog",
            .value = "softdog",
            .rule = "watchdog.softdog",
        },
    },
    .packages = .{.{ .value = "dhcpcd", .rules = .{"net.wired.dhcp"} }},
    .kconfig = .{
        .{ .value = "cpu-arm64", .rules = .{"arm.kernel"} },
        .{ .value = "cpu-arm64-aes", .rules = .{"arm.aes"} },
        .{ .value = "storage-virtio", .rules = .{"storage.virtio"} },
    },
    .features = .{.{ .value = "usb-common", .rules = .{"usb.common"} }},
    .firmware = .{},
    .cmdline = .{},
    .services = .{
        .{ .value = "dhcpcd-eth0", .rules = .{"net.wired.dhcp"} },
        .{ .value = "vh-acpid", .rules = .{"acpid.button"} },
        .{ .value = "vh-fstrim", .rules = .{"storage.trim"} },
    },
    .udev = .{},
    .deny = .{
        .{ .value = "rtsx_pci", .rules = .{"cardreader.off"} },
        .{ .value = "rtsx_pci_sdmmc", .rules = .{"cardreader.off"} },
        .{ .value = "uvcvideo", .rules = .{"camera.off"} },
    },
    .dracut = .{
        .{ .value = "hid_generic", .rules = .{"keyboard usb"} },
        .{ .value = "usbhid", .rules = .{"keyboard usb"} },
        .{ .value = "xhci_pci", .rules = .{"keyboard usb"} },
    },
    .modules = .{
        .{ .value = "hid_generic", .rules = .{ "device hid 0003:05AC:8105.0001", "device hid 0003:05AC:8106.0002" } },
        .{ .value = "usbcore", .rules = .{ "device usb 1-0:1.0", "device usb 2-0:1.0" } },
        .{ .value = "usbhid", .rules = .{ "device usb 1-1:1.0", "device usb 1-2:1.0" } },
        .{ .value = "virtio_pci", .rules = .{
            "device pci 0000:00:01.0",
            "device pci 0000:00:05.0",
            "device pci 0000:00:06.0",
            "device pci 0000:00:07.0",
            "device pci 0000:00:08.0",
            "device pci 0000:00:09.0",
            "device pci 0000:00:0a.0",
            "device pci 0000:00:0b.0",
            "device pci 0000:00:0c.0",
        } },
        .{ .value = "virtio_rng", .rules = .{"device virtio virtio7"} },
        .{ .value = "virtiofs", .rules = .{"device virtio virtio5"} },
        .{ .value = "vmw_vsock_virtio_transport", .rules = .{"device virtio virtio6"} },
        .{ .value = "xhci_pci", .rules = .{"device pci 0000:00:0d.0"} },
    },
    .exports = .{},
    .notes = .{},
    .luks = .{
        .cipher = "aes-xts-plain64",
        .key_size = 512,
        .pbkdf_memory_kib = 1048576,
        .pbkdf_parallel = 4,
    },
    .kernel = .{ .nr_cpus = 4, .march = "armv8-a" },
    .unknown = .{
        "acpi ACPI0007:00 acpi:ACPI0007:",
        "acpi ACPI0007:01 acpi:ACPI0007:",
        "acpi ACPI0007:02 acpi:ACPI0007:",
        "acpi ACPI0007:03 acpi:ACPI0007:",
        "acpi ARMH0061:00 acpi:ARMH0061:",
        "acpi LNXSYBUS:00 acpi:LNXSYBUS:",
        "acpi LNXSYBUS:01 acpi:LNXSYBUS:",
        "acpi LNXSYSTM:00 acpi:LNXSYSTM:",
        "acpi PNP0A08:00 acpi:PNP0A08:PNP0A03:",
        "acpi PNP0C02:00 acpi:PNP0C02:",
        "dmi id dmi:bvnAppleInc.:bvr2075.140.4.0.0:bd07/20/2025:svnAppleInc.:pnAppleVirtualizationGenericPlatform:pvr1:cvnAppleInc.:ct3:cvr1:sku:",
        "pci 0000:00:00.0 pci:v0000106Bd00001A05sv00000000sd00000000bc06sc00i00",
        "platform Fixed MDIO bus.0 platform:Fixed MDIO bus",
        "platform efivars.0 platform:efivars",
        "platform psci-cpuidle platform:psci-cpuidle",
        "platform regulatory.0 platform:regulatory",
    },
    .udev_known = .{"99-vh-dgpu-off.rules"},
}
