# vh-plan: the plan of qemu-virt for the shell installer (install/lib.sh). Every value comes
# from hwdb/ or is a number; plan-report.txt says which rule put it here.
VH_PLAN_ARCH='aarch64'
VH_PLAN_TIER='reduced'
VH_PLAN_SECURITY='tiered'
VH_PLAN_CLASS='vm'
VH_PLAN_TAGS='acpi disk disk-discard disk-nvme disk-on-nvme display efi efi64 iommu iommu-active keyboard keyboard-usb power-button tpm tpm2 vm wired'
VH_PLAN_MISSING='secure-boot'
VH_PLAN_ACKNOWLEDGE='secure-boot'
VH_PLAN_PACKAGES='dhcpcd tpm2-tools'
VH_PLAN_GAME_PACKAGES=''
VH_PLAN_KCONFIG='acpi-tiny-power-button-off cpu-arm64 cpu-arm64-aes gpu-virtio iommu-smmu storage-nvme tpm-tis'
VH_PLAN_FEATURES='usb-common'
VH_PLAN_FIRMWARE=''
VH_PLAN_CMDLINE=''
VH_PLAN_SERVICES='dhcpcd-eth0 vh-acpid vh-fstrim'
VH_PLAN_UDEV=''
VH_PLAN_UDEV_KNOWN='99-vh-dgpu-off.rules'
VH_PLAN_DENY='rtsx_pci rtsx_pci_sdmmc tiny_power_button uvcvideo'
VH_PLAN_DRACUT='hid_generic usbcore usbhid xhci_pci'
VH_PLAN_INTERNAL_INPUT=''
VH_PLAN_LUKS_CIPHER='aes-xts-plain64'
VH_PLAN_LUKS_KEY_SIZE='512'
VH_PLAN_LUKS_MEM_KIB='1048576'
VH_PLAN_LUKS_PARALLEL='4'
VH_PLAN_NR_CPUS='4'
VH_PLAN_MARCH='armv8-a'
VH_PLAN_RENDERER='pixman'
VH_PLAN_WATCHDOG='softdog'
