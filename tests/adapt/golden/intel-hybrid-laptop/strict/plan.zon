    .internal_input = .{},
    .exports = .{},
    .notes = .{
        .{ .value = "Dell: Secure Boot, Expert Key Management, Enable Custom Mode, then Delete All Keys.", .rules = .{"board.dell.secure-boot"} },
        .{ .value = "The TPM is Intel PTT, a firmware TPM inside the Management Engine: trusting tpm2-totp and the measured boot means trusting the ME (docs/03).", .rules = .{"tpm.ftpm.intel"} },
        .{ .value = "Thunderbolt/USB4: the thunderbolt driver is refused; USB devices and displays on these ports work, docks with PCIe devices (a network card) do not.", .rules = .{"quirk.thunderbolt"} },
        .{ .value = "The fingerprint reader is not used: there is no libfprint here, and logins use passwords.", .rules = .{"quirk.fingerprint"} },
        .{ .value = "Intel VMD (RAID/RST mode) is on: Linux reaches the NVMe disk through it. Switching the firmware setup to AHCI mode is simpler, but it changes how an installed Windows boots.", .rules = .{"storage.vmd"} },
    },
    .luks = .{
        .cipher = "aes-xts-plain64",
        .key_size = 512,
        .pbkdf_memory_kib = 1048576,
        .pbkdf_parallel = 4,
    },
    .kernel = .{ .nr_cpus = 16, .march = "alderlake" },
    .unknown = .{
        "pci 0000:00:00.0 pci:v00008086d00004621sv00001028sd00000AF3bc06sc00i00",
