# vh-plan: the plan of intel-hybrid-laptop for the shell installer (install/lib.sh). Every value comes
# from hwdb/ or is a number; plan-report.txt says which rule put it here.
VH_PLAN_ARCH='x86_64'
VH_PLAN_TIER='full'
VH_PLAN_SECURITY='strict'
VH_PLAN_CLASS='laptop'
VH_PLAN_TAGS='acpi backlight battery bluetooth camera disk disk-discard disk-nvme disk-on-nvme disk-on-vmd display efi efi64 epp hybrid iommu iommu-active keyboard keyboard-i8042 laptop lid mains mor platform-profile power-button secure-boot secure-boot-on smt sound tpm tpm2 usb-power wifi x86-64-v2 x86-64-v3'
VH_PLAN_MISSING=''
VH_PLAN_ACKNOWLEDGE=''
VH_PLAN_PACKAGES='alsa-ucm-conf bluez intel-media-driver intel-ucode iw iwd linux-firmware-intel linux-firmware-network sof-firmware tpm2-tools wireless-regdb'
VH_PLAN_KCONFIG='acpi-tiny-power-button-off audio-sof-intel bt-intel cpu-hybrid cpu-intel cpu-x86-aes gpu-i915 input-i8042 iommu-vtd storage-nvme storage-vmd tpm-crb'
VH_PLAN_FEATURES='bluetooth usb-common wifi'
VH_PLAN_FIRMWARE='i915/adlp_* i915/tgl_huc* intel-ucode/* intel/ibt-* intel/ish/ish_*.bin* intel/ish/ish_lnlm.bin* intel/sof* iwlwifi-so-a0-gf* regulatory.db*'
VH_PLAN_CMDLINE='efi=disable_early_pci_dma ia32_emulation=0 intel_iommu=on'
VH_PLAN_SERVICES='iwd vh-acpid vh-fstrim'
VH_PLAN_UDEV=''
VH_PLAN_UDEV_KNOWN='99-vh-dgpu-off.rules'
VH_PLAN_DENY='kvm kvm_intel mei mei_hdcp mei_me mei_pxp mei_wdt rtsx_pci rtsx_pci_sdmmc tiny_power_button uvcvideo'
VH_PLAN_DRACUT='atkbd i8042 vmd'
VH_PLAN_INTERNAL_INPUT=''
VH_PLAN_LUKS_CIPHER='aes-xts-plain64'
VH_PLAN_LUKS_KEY_SIZE='512'
VH_PLAN_LUKS_MEM_KIB='1048576'
VH_PLAN_LUKS_PARALLEL='4'
VH_PLAN_NR_CPUS='16'
VH_PLAN_MARCH='alderlake'
VH_PLAN_RENDERER='gles2'
VH_PLAN_WATCHDOG='iTCO_wdt'
