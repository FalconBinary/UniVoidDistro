# vh-plan: the plan of qemu-q35 for the shell installer (install/lib.sh). Every value comes
# from hwdb/ or is a number; plan-report.txt says which rule put it here.
VH_PLAN_ARCH='x86_64'
VH_PLAN_TIER='full'
VH_PLAN_SECURITY='strict'
VH_PLAN_CLASS='vm'
VH_PLAN_TAGS='acpi disk disk-discard disk-nvme disk-on-nvme display efi efi64 iommu iommu-active keyboard keyboard-i8042 mor power-button secure-boot setup-mode tpm tpm2 vm wired x86-64-v2 x86-64-v3'
VH_PLAN_MISSING=''
VH_PLAN_ACKNOWLEDGE=''
VH_PLAN_PACKAGES='dhcpcd tpm2-tools'
VH_PLAN_KCONFIG='cpu-x86-aes gpu-virtio input-i8042 iommu-vtd storage-nvme tpm-crb'
VH_PLAN_FEATURES='usb-common'
VH_PLAN_FIRMWARE=''
VH_PLAN_CMDLINE='efi=disable_early_pci_dma ia32_emulation=0 intel_iommu=on'
VH_PLAN_SERVICES='dhcpcd-eth0 vh-acpid vh-fstrim'
VH_PLAN_UDEV=''
VH_PLAN_DENY='kvm kvm_amd rtsx_pci rtsx_pci_sdmmc uvcvideo'
VH_PLAN_DRACUT='atkbd i8042'
VH_PLAN_LUKS_CIPHER='aes-xts-plain64'
VH_PLAN_LUKS_KEY_SIZE='512'
VH_PLAN_LUKS_MEM_KIB='1048576'
VH_PLAN_LUKS_PARALLEL='4'
VH_PLAN_NR_CPUS='4'
VH_PLAN_MARCH='x86-64-v3'
VH_PLAN_RENDERER='pixman'
VH_PLAN_WATCHDOG='softdog'
