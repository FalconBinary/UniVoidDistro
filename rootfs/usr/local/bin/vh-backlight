#!/bin/sh
# void-hardperf-light: brightness without root and without SUID: a sysfs write (group backlight).
#   vh-backlight +5 | -5 | 50   (percent)
set -eu
for d in /sys/class/backlight/*; do break; done
[ -w "$d/brightness" ] || { echo "no access to $d/brightness (group backlight?)" >&2; exit 1; }
max=$(cat "$d/max_brightness") cur=$(cat "$d/brightness")
step=$(( max / 100 )); [ "$step" -ge 1 ] || step=1
case ${1:?give +N, -N or N} in
	+*) v=$(( cur + ${1#+} * step )) ;;
	-*) v=$(( cur - ${1#-} * step )) ;;
	*)  v=$(( $1 * step )) ;;
esac
[ "$v" -lt "$step" ] && v=$step   # never turn the screen fully off
[ "$v" -gt "$max" ] && v=$max
echo "$v" > "$d/brightness"
