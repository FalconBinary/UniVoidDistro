#!/bin/sh
# void-hardperf-light: the browser sandbox (docs/08). Runs as the browser user.
#
# What Firefox sees inside:
#   /usr (read-only), a minimal /etc, its own /proc (without interrupt counters),
#   its own /dev, /tmp and /dev/shm as directories on the host tmpfs with noexec,
#   HOME as a persistent profile (trusted) or an empty tmpfs (untrusted),
#   ~/Downloads as the directory shared with the user, /home/xfer (nosymfollow, noexec),
#   Wayland only through vh-wlfilter, audio only through the pipewire-pulse socket with
#   restricted rights (no microphone), the GPU only as the iGPU render node (trusted).
# It does not see: the user's files, D-Bus, the main Wayland socket, PipeWire.
set -eu
PATH=/usr/bin
mode=${1:?}
uid=$(id -u) gid=$(id -g) user=$(id -un)
ff=/usr/lib/firefox
rt=/run/user/$uid
h=/home/$user

# Working directories on the host /tmp (tmpfs, noexec): a noexec inherited from a more
# privileged namespace cannot be removed inside a user namespace. The same path is reused:
# after the browser exits only garbage in RAM is left here.
work=/tmp/vh-browser/$mode
rm -rf "$work"
mkdir -p -m 0700 "/tmp/vh-browser" "$work"
mkdir -m 0700 "$work/tmp" "$work/shm" "$work/run"
# the sandbox seccomp filter (vh-seccomp browser): socket only UNIX/INET/NETLINK_ROUTE, no
# MPTCP, SCTP, AF_ALG, AF_PACKET, NETLINK_NETFILTER; no TCP_ULP or BPF on sockets, no mounts,
# keyctl, bpf, perf, clone with new namespaces. bwrap applies it after assembling the
# sandbox; every Firefox process inherits it on top of its own filter.
/usr/local/libexec/vh/vh-seccomp browser > "$work/seccomp.bpf"
printf '%s:x:%s:%s::%s:/usr/bin/nologin\n' "$user" "$uid" "$gid" "$h" > "$work/passwd"
printf '%s:x:%s:\n' "$user" "$gid" > "$work/group"

set -- \
	--unshare-all --share-net --unshare-user --disable-userns --assert-userns-disabled \
	--die-with-parent --new-session --cap-drop ALL --clearenv --seccomp 3 \
	--ro-bind /usr /usr \
	--symlink usr/bin /bin --symlink usr/bin /sbin \
	--symlink usr/lib /lib --symlink usr/lib /lib64 \
	--tmpfs "$ff"
# The Firefox directory is reassembled: the package files plus our autoconfig (policies
# cannot lock javascript.options.* and app.normandy.*). Then read-only.
for e in "$ff"/*; do
	n=${e##*/}
	[ "$n" = defaults ] && continue
	set -- "$@" --ro-bind "$e" "$ff/$n"
done
set -- "$@" \
	--ro-bind "$ff/defaults/pref/channel-prefs.js" "$ff/defaults/pref/channel-prefs.js" \
	--ro-bind /etc/vh/firefox/autoconfig.js "$ff/defaults/pref/vh-autoconfig.js" \
	--ro-bind "/etc/vh/firefox/vh-$mode.cfg" "$ff/vh.cfg" \
	--remount-ro "$ff" \
	--ro-bind /etc/fonts /etc/fonts \
	--ro-bind /etc/ssl /etc/ssl \
	--ro-bind /etc/resolv.conf /etc/resolv.conf \
	--ro-bind /etc/hosts /etc/hosts \
	--ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf \
	--ro-bind /etc/localtime /etc/localtime \
	--ro-bind-try /etc/ld.so.cache /etc/ld.so.cache \
	--ro-bind "$work/passwd" /etc/passwd \
	--ro-bind "$work/group" /etc/group \
	--ro-bind "/etc/vh/firefox/policies-$mode.json" /etc/firefox/policies/policies.json \
	--ro-bind-try /var/cache/fontconfig /var/cache/fontconfig \
	--proc /proc \
	--ro-bind /dev/null /proc/interrupts \
	--ro-bind /dev/null /proc/softirqs \
	--ro-bind /dev/null /proc/stat \
	--dev /dev \
	--bind "$work/tmp" /tmp \
	--bind "$work/shm" /dev/shm \
	--ro-bind /sys/devices/system/cpu /sys/devices/system/cpu \
	--bind "$work/run" "$rt" \
	--bind /run/vh-sandbox/wayland "$rt/wayland-0" \
	--bind-try /run/vh-sandbox/pulse "$rt/pulse/native"

if [ "$mode" = trusted ]; then
	# persistent profile: logins, bookmarks; the cache lives on tmpfs (policy)
	mkdir -p -m 0700 "$HOME/trusted"
	set -- "$@" --bind "$HOME/trusted" "$h"
	# GPU: only the iGPU render node (WebRender, VA-API), no card0 (KMS): docs/08
	for r in /sys/class/drm/renderD*; do
		[ -e "$r" ] || continue
		[ "$(basename "$(readlink -f "$r/device/driver")")" = i915 ] || continue
		set -- "$@" --dev-bind "/dev/dri/${r##*/}" "/dev/dri/${r##*/}" \
			--ro-bind /sys/dev/char /sys/dev/char \
			--ro-bind /sys/class/drm /sys/class/drm \
			--ro-bind /sys/devices/pci0000:00 /sys/devices/pci0000:00
		break
	done
else
	# throwaway profile: an empty HOME in RAM, no GPU (software rendering)
	mkdir -m 0700 "$work/home"
	set -- "$@" --bind "$work/home" "$h"
fi

set -- "$@" \
	--bind /home/xfer "$h/Downloads" \
	--chdir "$h" \
	--setenv HOME "$h" --setenv USER "$user" --setenv LOGNAME "$user" \
	--setenv PATH /usr/bin --setenv LANG "${LANG:-C.UTF-8}" \
	--setenv XDG_RUNTIME_DIR "$rt" --setenv WAYLAND_DISPLAY wayland-0 \
	--setenv PULSE_SERVER "unix:$rt/pulse/native" \
	--setenv MOZ_ENABLE_WAYLAND 1 --setenv MOZ_CRASHREPORTER_DISABLE 1 \
	--setenv GDK_BACKEND wayland \
	-- "$ff/firefox" --no-remote --profile "$h/profile"

# the profile is created inside HOME; the directory must exist
if [ "$mode" = trusted ]; then mkdir -p -m 0700 "$HOME/trusted/profile"; else mkdir -m 0700 "$work/home/profile"; fi
exec bwrap "$@" 3< "$work/seccomp.bpf"
