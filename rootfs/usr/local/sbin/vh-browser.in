#!/bin/sh
# void-hardperf-light: root launcher of the browser (docs/08). Called only through doas by
# a passwordless rule: "permit nopass @VH_USER@ as root cmd /usr/local/sbin/vh-browser
# args trusted|untrusted". It does one thing: drops privileges to the browser user and
# starts the sandbox assembly. Every step is an exec: the parent of bwrap stays the doas
# process itself, and its death (end of session: kill -KILL -1) ends the sandbox
# (bwrap --die-with-parent).
set -eu
PATH=/usr/bin
case ${1:-} in trusted|untrusted) ;; *) echo "usage: vh-browser trusted|untrusted" >&2; exit 2 ;; esac
[ "${DOAS_USER:-}" = "@VH_USER@" ] || { echo "vh-browser: only for @VH_USER@ through doas" >&2; exit 1; }
[ -S /run/vh-sandbox/wayland ] || { echo "vh-browser: no /run/vh-sandbox/wayland: vh-wlfilter is not running" >&2; exit 1; }
# nsenter into init's network namespace: if the user's session lives in an empty netns
# (optional/session-netns), the browser still needs the network. In the base layer this is a no-op.
exec nsenter --net=/proc/1/ns/net -- \
	setpriv --reuid=@VH_BROWSER_USER@ --regid=@VH_BROWSER_USER@ --init-groups --reset-env \
	--no-new-privs --inh-caps=-all --bounding-set=-all \
	/usr/local/libexec/vh/browser-sandbox "$1"
