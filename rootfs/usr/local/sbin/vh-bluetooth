#!/bin/sh
# void-hardperf-light: Bluetooth on demand (VH_BLUETOOTH=optional, docs/06, docs/12).
#   vh-bluetooth on   -- lift rfkill, start bluetoothd
#   vh-bluetooth off  -- stop bluetoothd, block the radio
# Called through doas without a password (these two arguments only).
set -eu
PATH=/usr/bin
case ${1:-} in
	on)
		rfkill unblock bluetooth
		[ -e /var/service/bluetoothd ] || ln -s /etc/sv/bluetoothd /var/service/
		sv -w 5 up bluetoothd >/dev/null
		echo on > /run/vh/bluetooth ;;
	off)
		[ -e /var/service/bluetoothd ] && sv -w 5 down bluetoothd >/dev/null
		rm -f /var/service/bluetoothd
		rfkill block bluetooth
		echo off > /run/vh/bluetooth ;;
	*) echo "usage: vh-bluetooth on|off" >&2; exit 2 ;;
esac
