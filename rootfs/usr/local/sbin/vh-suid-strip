#!/bin/sh
# void-hardperf-light: strip the SUID bits and file capabilities a package update brought
# back (chmod and setcap are undone by every update). docs/05, docs/09.
# Only doas and unix_chkpwd keep SUID (without it swaylock cannot check the password).
#   vh-suid-strip [--quiet] [--audit]
set -u
PATH=/usr/bin
q=0; [ "${1:-}" = --quiet ] && q=1
say() { [ "$q" = 1 ] || echo "$*"; }

# Needed by root only: SUID is stripped (root runs them without it).
for f in /usr/bin/passwd /usr/bin/chage /usr/bin/mount /usr/bin/umount; do
	[ -u "$f" ] && chmod u-s "$f" && say "SUID stripped: $f"
done
# Needed by nobody: excluded through noextract; if they appeared anyway, strip them.
for f in /usr/bin/su /usr/bin/sg /usr/bin/newgrp /usr/bin/chsh /usr/bin/chfn \
	/usr/bin/expiry /usr/bin/gpasswd /usr/bin/newuidmap /usr/bin/newgidmap \
	/usr/bin/wall /usr/bin/write /usr/lib/utempter/utempter /usr/bin/xbps-uchroot \
	/usr/libexec/dbus-daemon-launch-helper; do
	[ -e "$f" ] && chmod u-s,g-s "$f" && say "SUID/SGID stripped: $f (noextract was expected)"
done
# Files whose bits vh-pkg stripped when programs were installed (an update would restore them).
if [ -r /etc/vh/suid-strip.list ]; then
	grep -v '^#' /etc/vh/suid-strip.list | while IFS= read -r f; do
		[ -f "$f" ] || continue
		if [ -u "$f" ] || [ -g "$f" ]; then chmod u-s,g-s "$f" && say "SUID/SGID stripped: $f (vh-pkg)"; fi
		[ -n "$(getcap "$f" 2>/dev/null)" ] && setcap -r "$f" && say "capabilities stripped: $f (vh-pkg)"
	done
fi
# ping: ICMP sockets through net.ipv4.ping_group_range instead of cap_net_raw.
for f in /usr/bin/iputils-ping /usr/bin/ping; do
	[ -f "$f" ] && [ ! -L "$f" ] && [ -n "$(getcap "$f" 2>/dev/null)" ] && setcap -r "$f" && say "capabilities stripped: $f"
done

if [ "${1:-}" = --audit ]; then
	echo "SUID/SGID in the system (only doas and unix_chkpwd are expected):"
	find / -xdev \( -perm -4000 -o -perm -2000 \) -type f 2>/dev/null | sed 's/^/  /'
	echo "file capabilities (expected empty):"
	getcap -r /usr 2>/dev/null | sed 's/^/  /'
fi
exit 0
