#!/bin/sh
# void-hardperf-light: power profile without daemons (docs/11). Called by a udev rule when
# the charger is plugged in or out, and once at boot. Takes no arguments.
#   on AC:       EPP balance_performance, runtime PM of PCI devices off (on)
#   on battery:  EPP balance_power,       runtime PM on (auto)
# Wi-Fi power saving is not switched by the profile: it is always off (docs/07).
set -u
PATH=/usr/bin
on_ac=0 has_bat=0
for s in /sys/class/power_supply/*; do
	[ -r "$s/type" ] || continue
	case $(cat "$s/type") in
		Mains) [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && on_ac=1 ;;
		Battery) has_bat=1 ;;
	esac
done
[ "$has_bat" = 0 ] && on_ac=1   # desktop PC or VM

if [ "$on_ac" = 1 ]; then epp=balance_performance rpm=on state=ac
else epp=balance_power rpm=auto state=battery; fi

for p in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference; do
	[ -w "$p" ] && echo "$epp" > "$p"
done
for d in /sys/bus/pci/devices/*; do
	# bridges are left alone (the dGPU sleeps through them), NVIDIA is always auto (docs/04)
	case $(cat "$d/class") in 0x0604*) continue ;; esac
	[ "$(cat "$d/vendor")" = 0x10de ] && continue
	[ -w "$d/power/control" ] && echo "$rpm" > "$d/power/control" 2>/dev/null
done
install -d -m 0755 /run/vh
echo "$state" > /run/vh/power
