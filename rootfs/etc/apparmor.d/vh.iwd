# void-hardperf-light: iwd, Wi-Fi (docs/06). The only profile with AF_ALG: iwd does its
# cryptography through the kernel. Shipped in complain mode: the bench has no Wi-Fi to
# exercise every path (WPA3, 802.1X, roaming). After a week of use check the denials
# (doas svlogtail kernel | grep vh.iwd) and enforce it: doas aa-enforce /etc/apparmor.d/vh.iwd
abi <abi/4.0>,
include <tunables/global>

profile vh.iwd /usr/libexec/iwd flags=(complain) {
  include <abstractions/base>

  capability net_admin,
  capability net_raw,
  capability net_bind_service,

  network netlink raw,
  network netlink dgram,
  network alg seqpacket,
  network packet raw,
  network packet dgram,
  network inet dgram,
  network inet raw,
  network unix stream,
  network unix dgram,

  /usr/libexec/iwd mr,
  /etc/iwd/ r,
  /etc/iwd/** r,
  /var/lib/iwd/ rw,
  /var/lib/iwd/** rwk,
  /run/dbus/system_bus_socket rw,
  /dev/rfkill rw,
  /proc/sys/net/** rw,
  /sys/class/** r,
  /sys/devices/** r,
  /sys/module/** r,
  /proc/*/** r,
  /etc/hosts r,
  /etc/hostname r,

  deny userns,
  deny mount,

  include if exists <local/vh.iwd>
}
