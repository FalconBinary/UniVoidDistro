# vim: set ts=4 sw=4 et:
# void-hardperf-light: swap in compressed memory (zram), no swap partition, no zramen (docs/11).
[ -e /sys/block/zram0 ] || modprobe zram num_devices=1 || return 0
if [ "$(cat /sys/block/zram0/disksize)" = 0 ]; then
    # msg passes the text to printf as the format: a percent sign is not allowed in it
    msg "vh: zram (@VH_ZRAM_ALGO@, @VH_ZRAM_PERCENT@ percent of RAM)..."
    echo @VH_ZRAM_ALGO@ > /sys/block/zram0/comp_algorithm
    _vh_kb=$(awk '/MemTotal/ {print int($2 * @VH_ZRAM_PERCENT@ / 100)}' /proc/meminfo)
    echo "${_vh_kb}K" > /sys/block/zram0/disksize
    mkswap /dev/zram0 >/dev/null && swapon -p 100 /dev/zram0
    unset _vh_kb
fi
