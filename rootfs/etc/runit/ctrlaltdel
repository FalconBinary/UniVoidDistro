#!/bin/sh
# /etc/runit/ctrlaltdel, UniVoidDistro's (an update of runit-void does not replace it:
# /etc/xbps.d/30-vh-noextract.conf). The installer's file, kept thin: what it does is in the
# package vh-base, whose updates reach it (docs/uni/rolling.md, "What no package owns").

PATH=/usr/bin:/usr/sbin

[ ! -x /usr/local/libexec/vh/vh-ctrlaltdel ] || exec /usr/local/libexec/vh/vh-ctrlaltdel

# no package: Void's ctrlaltdel, on to stage 3, which reboots
chmod 100 /run/runit/stopit
chmod 100 /run/runit/reboot
