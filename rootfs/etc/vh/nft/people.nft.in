# void-hardperf-light: outgoing network of root and people, BASE layer (included from
# /etc/nftables.conf, chain output). Strict mode: optional/strict-net (docs/13).
# root: HTTPS only (xbps); root cannot do without the mirrors' DNS names, see lo-dns.nft
meta skuid "root" tcp dport 443 accept
# the everyday user and the admin have network (git, ssh, ping through ping_group_range)
meta skuid "@VH_USER@" accept
meta skuid "@VH_ADMIN@" accept
