#!/bin/bash
# void-hardperf-light: back to the normal login on tty1.
. "$(dirname "$0")/../lib.sh"
conf=/etc/sv/agetty-tty1/conf
if [ -e "$conf.vh-orig" ]; then restore_orig "$conf"; else sed -i 's| --login-program /usr/local/sbin/vh-login-netns||' "$conf"; fi
mark_disabled
echo "Takes effect from the next login on tty1."
