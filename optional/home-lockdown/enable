#!/bin/bash
# void-hardperf-light: a home directory without autostart points (docs/13, home-lockdown).
# $HOME is root:<user's group> 0750: the user cannot create ~/.bash_profile,
# ~/.local/share/applications/*.desktop or a ~/.bashrc with their own command (the RefursWM
# and RefursLine configs are compiled into the binaries and do not live in $HOME).
# Only the listed directories are writable. Configs are root's, read-only; editing goes
# through ~/config-drafts and vh-apply-config (the admin sees the diff and the lines that run programs).
. "$(dirname "$0")/../lib.sh"
u=$VH_USER
h=/home/$u
g=$(id -gn "$u")
WRITABLE="Documents Projects Pictures Videos Music config-drafts .cache .local/state .local/share/wireplumber"   # the RefursLine launcher history lives in .cache/refursline
[ -n "${VH_DEV_DIR:-}" ] && WRITABLE="$WRITABLE $VH_DEV_DIR"

cat <<EOT
These stay writable: $WRITABLE (+ ~/Downloads -> /home/xfer).
Everything else in $h becomes read-only. Files that programs save elsewhere (for example
~/.config/<program>/state) will stop being saved: add their directories to the WRITABLE
list in this script, or move settings through ~/config-drafts.
Run this while $u is not in a session (leave RefursWM).
EOT
confirm_exact lock "Lock down the home directory of $u?"
pgrep -u "$u" >/dev/null && die "$u has running processes: log out of the session"

install -m 0755 "$MOD_DIR/vh-apply-config" /usr/local/sbin/vh-apply-config
# writable directories belong to the user
for w in $WRITABLE; do
	install -d -m 0700 -o "$u" -g "$g" "$h/$w"
done
chown "$u:$g" "$h/.local/state" "$h/.cache"
# configs and everything else: root, read-only
for f in .bashrc .bash_profile .profile .inputrc .bash_logout; do
	[ -e "$h/$f" ] || : > "$h/$f"
done
printf '%s\n' "# void-hardperf-light: the history lives in a writable directory" \
	'HISTFILE=$HOME/.local/state/bash_history' >> "$h/.bashrc"
for p in "$h"/.[!.]* "$h"/*; do
	[ -e "$p" ] || [ -L "$p" ] || continue
	n=${p#"$h"/}
	keep=0
	for w in $WRITABLE Downloads .local; do [ "$n" = "${w%%/*}" ] && keep=1; done
	[ "$keep" = 1 ] && continue
	chown -R -h root:root "$p"
	chmod -R go-w,u+rwX "$p"
	[ -d "$p" ] && chmod 0755 "$p"
done
# ~/.local is root's; inside, only state and share/<application> are writable
chown root:root "$h/.local" "$h/.local/share" 2>/dev/null || true
chmod 0755 "$h/.local" "$h/.local/share" 2>/dev/null || true
# ~/.gnupg: the user writes the data, the executable config (pinentry-program) is root's (sticky)
if [ -d "$h/.gnupg" ]; then
	chown root:"$g" "$h/.gnupg"; chmod 1770 "$h/.gnupg"
	for c in gpg-agent.conf gpg.conf dirmngr.conf scdaemon.conf; do
		[ -e "$h/.gnupg/$c" ] || : > "$h/.gnupg/$c"
		chown root:root "$h/.gnupg/$c"; chmod 0644 "$h/.gnupg/$c"
	done
fi
chown root:"$g" "$h"; chmod 0750 "$h"
# git: hooks and fsmonitor from repositories (for example from downloads) do not execute
if ! grep -q 'hooksPath' /etc/gitconfig 2>/dev/null; then
	install -d -m 0755 /etc/vh/git-hooks-none
	printf '%s\n' "# void-hardperf-light (optional/home-lockdown): foreign repositories do not run their own code" \
		"[core]" "	hooksPath = /etc/vh/git-hooks-none" "	fsmonitor = false" >> /etc/gitconfig
fi
grep -q 'vh-apply-config' /etc/doas.conf || true
mark_enabled
echo "Done. Your own settings: edit ~/config-drafts/..., then the admin runs doas vh-apply-config."
