#!/bin/sh
# void-hardperf-light: temporary network permissions of strict mode (optional/strict-net, docs/13).
# Only elements of sets declared in advance, with a timeout, change: rules and chains are
# untouched, and the kernel removes a permission itself when it expires (rollback without a daemon).
#   doas vh-net status
#   doas vh-net xbps [MIN]            root: DNS and HTTPS to the mirrors from /etc/xbps.d (30 min)
#   doas vh-net allow NAME [MIN]      network and DNS for a user (10 min)
#   doas vh-net revoke NAME           revoke early
set -eu
PATH=/usr/bin
[ "$(id -u)" = 0 ] || { echo "run: doas vh-net ..." >&2; exit 1; }
usage() { sed -n '4,7p' "$0" | sed 's/^# //' >&2; exit 2; }
minutes() {
	case $1 in ''|*[!0-9]*) echo "vh-net: minutes must be an integer" >&2; exit 2 ;; esac
	[ "$1" -ge 1 ] && [ "$1" -le 240 ] || { echo "vh-net: 1 to 240 minutes" >&2; exit 2; }
	echo "$1"
}
uid_of() {
	u=$(id -u "$1" 2>/dev/null) || { echo "vh-net: no user $1" >&2; exit 2; }
	[ "$u" -ne 0 ] || { echo "vh-net: root only through \"vh-net xbps\"" >&2; exit 2; }
	echo "$u"
}
nft list table inet vh >/dev/null 2>&1 || { echo "vh-net: no table inet vh" >&2; exit 1; }

case ${1:-} in
	status)
		if grep -q 'people_tmp accept' /etc/vh/nft/people.nft 2>/dev/null; then
			echo "mode: strict (optional/strict-net)"
		else
			echo "mode: base (people have network)"
		fi
		for s in root_https people_tmp dns_tmp; do
			printf '%s: ' "$s"
			# set elements: "value timeout ... expires ..." comma separated (may span several lines)
			nft list set inet vh "$s" | awk '
				/elements = \{/ { f = 1; sub(/.*elements = \{[ \t]*/, "") }
				f { e = e " " $0; if (index($0, "}")) f = 0 }
				END { sub(/[ \t]*\}.*/, "", e); gsub(/[ \t]+/, " ", e); sub(/^ /, "", e); print (e == "" ? "-" : e) }'
		done ;;
	xbps)
		m=$(minutes "${2:-30}")
		nft add element inet vh dns_tmp "{ 0 timeout ${m}m }"
		# the xbps mirrors and thor's fallback mirrors (thor mirror --write, docs/18)
		hosts=$( { sed -n 's|^repository=https://\([^/:]*\).*|\1|p' /etc/xbps.d/*.conf
			sed -n 's|^mirror-fallback=https://\([^/:]*\).*|\1|p' /etc/thor/thor.conf 2>/dev/null; } | sort -u)
		[ -n "$hosts" ] || { echo "vh-net: no https mirrors in /etc/xbps.d" >&2; exit 1; }
		n=0
		for h in $hosts; do
			for ip in $(getent ahostsv4 "$h" | awk '{print $1}' | sort -u); do
				nft add element inet vh root_https "{ $ip timeout ${m}m }"
				n=$((n + 1))
			done
		done
		[ "$n" -gt 0 ] || { echo "vh-net: the mirror names did not resolve (no network?)" >&2; exit 1; }
		echo "root: DNS and HTTPS to the mirrors ($hosts, $n addresses) for $m min" ;;
	allow)
		uid=$(uid_of "${2:?$(usage)}")
		m=$(minutes "${3:-10}")
		nft add element inet vh people_tmp "{ $uid timeout ${m}m }"
		nft add element inet vh dns_tmp "{ $uid timeout ${m}m }"
		echo "$2: network and DNS for $m min" ;;
	revoke)
		uid=$(uid_of "${2:?$(usage)}")
		nft delete element inet vh people_tmp "{ $uid }" 2>/dev/null || true
		nft delete element inet vh dns_tmp "{ $uid }" 2>/dev/null || true
		echo "$2: permission revoked" ;;
	*) usage ;;
esac
