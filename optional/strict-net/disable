#!/bin/bash
# void-hardperf-light: disable strict network mode: back to the base layer's rules.
. "$(dirname "$0")/../lib.sh"
render "$VH_ROOT/rootfs/etc/vh/nft/people.nft.in" /etc/vh/nft/people.nft
render "$VH_ROOT/rootfs/etc/vh/nft/lo-dns.nft.in" /etc/vh/nft/lo-dns.nft
rm -f /etc/vh/nft/people.nft.vh-orig /etc/vh/nft/lo-dns.nft.vh-orig
reload_nft || die "the nftables ruleset did not load"
mark_disabled
