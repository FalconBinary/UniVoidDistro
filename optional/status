#!/bin/bash
# void-hardperf-light: which paranoid modules are enabled (docs/13).
. "$(dirname "$0")/../install/lib.sh"
for d in "$(dirname "$0")"/*/; do
	m=$(basename "$d")
	[ -x "$d/enable" ] || continue
	if [ -e "/etc/vh/optional/$m" ]; then
		printf '  [on ]  %-18s since %s\n' "$m" "$(cat "/etc/vh/optional/$m")"
	else
		printf '  [   ]  %s\n' "$m"
	fi
done
