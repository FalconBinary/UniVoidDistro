#!/bin/sh
# void-hardperf-light: add your own FIDO2 key to the list of authorised devices (optional/usb-auth).
#   doas vh-usb-allow-key      -- the key must be plugged in directly (not through a hub)
#                                 into the port where you will use it
# Binding: the exact port + VID:PID + serial + exactly one HID interface without the boot
# protocol. VID:PID and the serial can be forged; what matters is the port and the ban on a
# keyboard interface.
set -eu
PATH=/usr/bin
[ "$(id -u)" = 0 ] || exit 1
for d in /sys/bus/usb/devices/[0-9]*-[0-9]*; do
	case ${d##*/} in *:*) continue ;; esac
	[ "$(cat "$d/authorized")" = 0 ] || continue
	line="${d##*/} $(cat "$d/idVendor"):$(cat "$d/idProduct") $(cat "$d/serial" 2>/dev/null || echo -)"
	printf 'found: %s  "%s %s"\nadd? [y/N] ' "$line" "$(cat "$d/manufacturer" 2>/dev/null)" "$(cat "$d/product" 2>/dev/null)"
	read -r a
	case $a in y|Y) echo "$line" >> /etc/vh/usb-keys.conf; echo "added; remove and reinsert the key" ;; esac
done
