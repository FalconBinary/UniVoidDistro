#!/bin/sh
# void-hardperf-light: the media with the Secure Boot keys (optional/sb-offline-keys, docs/13).
#   doas vh-keys mount    -- turn the network off, open the media's LUKS, attach the keys
#   doas vh-keys umount   -- detach the keys, close the media, bring the network back
#   doas vh-keys status
# While the db key is attached there is no network: a remote attacker gets no chance to use it.
set -eu
PATH=/usr/bin
[ "$(id -u)" = 0 ] || { echo "run: doas vh-keys ..." >&2; exit 1; }
. /etc/vh/keys.conf          # KEYS_UUID: UUID of the LUKS partition on the media
MNT=/run/vh-keys KEYS=/var/lib/sbctl/keys NET=/run/vh-keys.net

case ${1:-} in
	mount)
		mountpoint -q "$KEYS" && { echo "the keys are already attached"; exit 0; }
		dev=/dev/disk/by-uuid/$KEYS_UUID
		[ -b "$dev" ] || { echo "media $KEYS_UUID not found: insert it" >&2; exit 1; }
		# network: remember the state and turn it off
		{
			rfkill list wlan 2>/dev/null | grep -q 'Soft blocked: yes' && echo wlan=blocked || echo wlan=on
			[ -d /sys/class/net/eth0 ] && grep -q up /sys/class/net/eth0/operstate && echo eth0=up || echo eth0=down
		} > "$NET"
		rfkill block all
		[ -d /sys/class/net/eth0 ] && ip link set eth0 down
		echo "network off"
		cryptsetup open "$dev" vh-keys
		install -d -m 0700 "$MNT"
		mount -o nosuid,nodev,noexec /dev/mapper/vh-keys "$MNT"
		mount --bind "$MNT/sbctl" "$KEYS"
		echo "keys attached: $KEYS (UKI reference values: $MNT/ref)" ;;
	umount)
		sync
		mountpoint -q "$KEYS" && umount "$KEYS"
		mountpoint -q "$MNT" && umount "$MNT"
		[ -e /dev/mapper/vh-keys ] && cryptsetup close vh-keys
		if [ -e "$NET" ]; then
			grep -q wlan=on "$NET" && rfkill unblock wlan
			grep -q eth0=up "$NET" && ip link set eth0 up
			rm -f "$NET"
		else
			rfkill unblock wlan
		fi
		echo "keys detached, the media can be removed; network restored" ;;
	status)
		if mountpoint -q "$KEYS"; then echo "keys attached (network off)"; else echo "keys not attached"; fi ;;
	*) sed -n '3,5p' "$0" | sed 's/^# //' >&2; exit 2 ;;
esac
