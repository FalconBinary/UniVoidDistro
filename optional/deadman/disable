#!/bin/bash
# void-hardperf-light: disable the dead man's switch.
. "$(dirname "$0")/../lib.sh"
wd=no; grep -q '^WATCHDOG=yes' /etc/vh/deadman.conf 2>/dev/null && wd=yes
rm -f /etc/runit/shutdown.d/85-vh-deadman.sh /etc/dracut.conf.d/21-vh-deadman.conf /etc/modprobe.d/vh-itco.conf
rm -rf /usr/lib/dracut/modules.d/91vhdeadman
sed -i 's/^IDLE_LOCK_MIN=.*/IDLE_LOCK_MIN=0/; s/^IDLE_POWEROFF_MIN=.*/IDLE_POWEROFF_MIN=0/' /etc/vh/acpi.conf
sv restart vh-acpid >/dev/null 2>&1 || true
rebuild_uki
mark_disabled
if [ "$wd" = yes ]; then
	echo "The hardware watchdog is armed with nowayout: the vh-deadman service keeps petting it until reboot"
	echo "and removes itself at the next boot."
else
	rm -f /var/service/vh-deadman
fi
