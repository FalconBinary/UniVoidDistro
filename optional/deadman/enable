#!/bin/bash
# void-hardperf-light: dead man's switch, wiping the LUKS key from RAM (docs/13, deadman).
#   doas /root/vh/optional/deadman/enable
. "$(dirname "$0")/../lib.sh"
load_plan /root/vh/plan.env
MOR=/sys/firmware/efi/efivars/MemoryOverwriteRequestControl-e20939be-32d4-41be-a150-897f85d49829
if [ -e "$MOR" ]; then ok "MOR is supported: a reboot through the firmware wipes RAM"
else warn "MOR not found: after wiping the key the machine powers off (sysrq o); the firmware does not wipe RAM"; fi
# The watchdog of the board, as the plan names it (VH_PLAN_WATCHDOG: hwdb's cpu.*.watchdog and
# arm.watchdog.* rules, softdog when no hardware one is known). A firmware that disabled the
# hardware watchdog leaves its driver without a device: then there is no /dev/watchdog.
wdm=${VH_PLAN_WATCHDOG:-softdog}
modprobe "$wdm" 2>/dev/null || true   # built in, already loaded, or the module lock is on
wd=no
if [ -e /dev/watchdog ]; then
	wd=yes
	id=$(cat /sys/class/watchdog/watchdog0/identity 2>/dev/null)
	drv=$(basename "$(readlink -f /sys/class/watchdog/watchdog0/device/driver 2>/dev/null)" 2>/dev/null | tr - _)
	if [ "$wdm" = softdog ]; then
		warn "softdog ($id): no hardware watchdog is known for this board; a software one resets a dead or hung vh-deadman, not a hung kernel (docs/uni/runtime.md)"
	elif [ "$drv" = "$wdm" ]; then
		ok "$wdm ($id): the board's hardware watchdog; vh-deadman pets it"
	else
		warn "the plan names $wdm, but /dev/watchdog is ${drv:-a watchdog without a device} ($id); vh-deadman pets that one"
	fi
else
	warn "$wdm: no watchdog device (the firmware may have disabled it); vh-deadman runs without one"
fi

tag=""
cat <<EOT

The tag is a USB device whose removal means an alarm shutdown (without saving the last
seconds of work). For example a small USB stick on a lanyard, the other end on you.
Empty means no tag (only the key combination and regular shutdown).
EOT
printf 'Insert the tag and press Enter (or type "none"): '
read -r a
if [ "$a" != none ]; then
	sleep 1
	d=$(ls -td /sys/bus/usb/devices/[0-9]*-[0-9]* 2>/dev/null | grep -v : | head -1)
	[ -n "$d" ] || die "no USB device found"
	tag="$(cat "$d/idVendor"):$(cat "$d/idProduct")"
	echo "tag: $tag ($(cat "$d/manufacturer" 2>/dev/null) $(cat "$d/product" 2>/dev/null))"
fi
printf 'Alarm combination Right Ctrl + Right Alt + End on the built-in keyboard? [y/N] '
read -r a; combo=no; case $a in y|Y) combo=yes ;; esac

cat > /etc/vh/deadman.conf <<EOT
# void-hardperf-light: dead man's switch (optional/deadman, docs/13)
# Tag: VID:PID of a USB device (lsusb). Removal = alarm shutdown.
TAG="$tag"
# Right Ctrl + Right Alt + End on the built-in keyboard = alarm shutdown: a PS/2 or I2C one by
# its bus, one on internal USB, SPI or the host bus by INTERNAL_INPUT in /etc/vh/acpi.conf (the
# installer's probe); never a keyboard plugged in from outside or a virtual one (uinput)
COMBO=$combo
# the watchdog of the board ($wdm, from the plan): the daemon pets it; a dead or hung daemon
# = reset (a hardware one resets through the firmware, and MOR wipes RAM), failing towards the safe side
WATCHDOG=$wd
EOT
install -m 0755 "$MOD_DIR/vh-deadman" /usr/local/sbin/vh-deadman
install -m 0644 "$MOD_DIR/85-vh-deadman.sh" /etc/runit/shutdown.d/85-vh-deadman.sh
rm -rf /etc/sv/vh-deadman; cp -r "$MOD_DIR/sv/vh-deadman" /etc/sv/vh-deadman
rm -rf /usr/lib/dracut/modules.d/91vhdeadman; cp -r "$MOD_DIR/91vhdeadman" /usr/lib/dracut/modules.d/91vhdeadman
echo 'add_dracutmodules+=" vhdeadman "' > /etc/dracut.conf.d/21-vh-deadman.conf
if [ "$wd" = yes ]; then
	# nowayout: nobody stops it, root included; every watchdog driver has the parameter, and
	# vh-deadman sets the timeout through the watchdog API (60 s where the driver allows it)
	rm -f /etc/modprobe.d/vh-itco.conf   # its name before U2
	echo "options $wdm nowayout=1" > /etc/modprobe.d/vh-watchdog.conf
	grep -qx "$wdm" /etc/vh/modules.preload 2>/dev/null || echo "$wdm" >> /etc/vh/modules.preload 2>/dev/null || true
fi
# idle: lock after 15 min without physical input, power off after 60 (vh-acpid)
sed -i 's/^IDLE_LOCK_MIN=.*/IDLE_LOCK_MIN=15/; s/^IDLE_POWEROFF_MIN=.*/IDLE_POWEROFF_MIN=60/' /etc/vh/acpi.conf
grep -q '^IDLE_LOCK_MIN=' /etc/vh/acpi.conf || printf 'IDLE_LOCK_MIN=15\nIDLE_POWEROFF_MIN=60\n' >> /etc/vh/acpi.conf
sv restart vh-acpid >/dev/null 2>&1 || true
/usr/local/sbin/vh-deadman test
ln -sfn /etc/sv/vh-deadman /var/service/vh-deadman
rebuild_uki
mark_enabled
cat <<EOT
Active: alarm shutdown (tag/combination); regular shutdown and reboot end with wiping the
key and RAM. Verification: on the bench with a memory dump (docs/13).
Tag state: cat /run/vh/deadman
EOT
