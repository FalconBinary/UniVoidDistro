// session/profiles/game.zon: the gaming root, /var/lib/vh/roots/game (vh-game, track G).
// Compiled into vh-root and vh-game. The packages every gaming root gets; the Vulkan driver of
// the machine's GPU comes from the plan (hwdb, game_packages), never from this file.
.{
    .name = "game",
    .why = "the gaming session on tty3: gamescope, its Xwayland, Mesa and Vulkan",
    .packages = .{ "base-files", "bash", "coreutils", "mesa-dri", "vulkan-loader", "Vulkan-Tools", "gamescope" },
    // thor's deny list keeps Xwayland out of the system (no window isolation); inside this root
    // it is the X server of gamescope, which shows the games' windows only
    .allow = .{"xorg-server-xwayland"},
    // what nothing in the root reads: documentation, and firmware (the kernel loads the system's)
    .noextract = .{ "/usr/share/doc/*", "/usr/share/man/*", "/usr/share/info/*", "/usr/lib/firmware/*" },
    // the system's repository files copied in: the main repository only
    .repositories = .{"00-repository-main.conf"},
    // the root's own directory: root:game 0750, so that only the game user's session can read it
    .mode = 0o750,
}
