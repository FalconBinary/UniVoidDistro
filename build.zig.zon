.{
    .name = .univoiddistro,
    .version = "0.0.0",
    .fingerprint = 0x67b40641cc4f811d,
    .minimum_zig_version = "0.17.0",
    // one path dependency per track; the root build.zig lists the same names
    .dependencies = .{
        .tools = .{ .path = "zig" },
        .kernel = .{ .path = "kernel" },
        .init = .{ .path = "init" },
        .sched = .{ .path = "sched" },
        .adapt = .{ .path = "adapt" },
        .session = .{ .path = "session" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
    },
}
